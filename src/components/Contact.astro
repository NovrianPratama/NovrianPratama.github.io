---
import { siteConfig } from "../config";
---

<section id="contact" class="px-5 py-12 sm:px-8 sm:py-16 md:px-12 md:py-20 bg-gray-50 dark:bg-zinc-900 transition-colors duration-200">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">

      <!-- Left Column: Eyebrow, Heading, Text, Email, Social Icons -->
      <div class="lg:col-span-5 space-y-6 reveal-item">
        <div>
          <span
            data-i18n="contact.eyebrow"
            class="inline-block text-xs font-semibold uppercase tracking-widest pb-1 border-b-2 mb-3 text-teal-700 dark:text-teal-400 border-[#0F766E] dark:border-teal-400"
          >
            Contact
          </span>
          <h2
            data-i18n="contact.heading"
            class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-zinc-100"
          >
            Contact
          </h2>
          <div class="w-14 h-1.5 mt-2.5 rounded-full bg-[#0F766E] dark:bg-teal-400"></div>
        </div>

        <p
          data-i18n="contact.intro"
          class="text-base sm:text-lg text-gray-600 dark:text-zinc-400 leading-relaxed"
        >
          Open to Data Analyst, BI Analyst, and Business Analyst roles, especially in FMCG. Feel free to reach out or view my work.
        </p>

        <!-- Direct Email Link -->
        <div>
          <a
            href={`mailto:${siteConfig.social.email}`}
            class="inline-flex items-center gap-3 min-h-[44px] text-sm sm:text-base font-medium text-gray-800 dark:text-zinc-100 hover:text-teal-700 dark:hover:text-teal-400 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-teal-700 dark:text-teal-400 flex-shrink-0" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span>{siteConfig.social.email}</span>
          </a>
        </div>

        <!-- Social Icons Row -->
        <div class="pt-2">
          <p
            data-i18n="contact.findMeOn"
            class="text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-zinc-500 mb-3"
          >
            Find me on
          </p>
          <div class="flex flex-wrap items-center gap-2.5">
            {siteConfig.social?.linkedin && (
              <a
                href={siteConfig.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
                class="w-11 h-11 rounded-xl border border-gray-200 dark:border-white/10 bg-white dark:bg-zinc-800 flex items-center justify-center text-gray-600 dark:text-zinc-400 hover:border-teal-600 dark:hover:border-teal-400 hover:text-teal-700 dark:hover:text-teal-400 dark:hover:bg-white/10 transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M8 11v5"></path><path d="M8 8v.01"></path>
                  <path d="M12 16v-5"></path>
                  <path d="M16 16v-3a2 2 0 1 0 -4 0"></path>
                  <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z"></path>
                </svg>
              </a>
            )}
            {siteConfig.social?.github && (
              <a
                href={siteConfig.social.github}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="GitHub"
                class="w-11 h-11 rounded-xl border border-gray-200 dark:border-white/10 bg-white dark:bg-zinc-800 flex items-center justify-center text-gray-600 dark:text-zinc-400 hover:border-teal-600 dark:hover:border-teal-400 hover:text-teal-700 dark:hover:text-teal-400 dark:hover:bg-white/10 transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                  <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"></path>
                </svg>
              </a>
            )}
            {siteConfig.social?.medium && (
              <a
                href={siteConfig.social.medium}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Medium"
                class="w-11 h-11 rounded-xl border border-gray-200 dark:border-white/10 bg-white dark:bg-zinc-800 flex items-center justify-center text-gray-600 dark:text-zinc-400 hover:border-teal-600 dark:hover:border-teal-400 hover:text-teal-700 dark:hover:text-teal-400 dark:hover:bg-white/10 transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
                </svg>
              </a>
            )}
            {siteConfig.social?.kaggle && (
              <a
                href={siteConfig.social.kaggle}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Kaggle"
                class="w-11 h-11 rounded-xl border border-gray-200 dark:border-white/10 bg-white dark:bg-zinc-800 flex items-center justify-center text-gray-600 dark:text-zinc-400 hover:border-teal-600 dark:hover:border-teal-400 hover:text-teal-700 dark:hover:text-teal-400 dark:hover:bg-white/10 transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M18.825 23.859c-.022.092-.117.141-.281.141h-3.139c-.187 0-.351-.082-.492-.248l-5.178-6.589-1.448 1.374v5.111c0 .235-.117.352-.351.352H5.505c-.236 0-.354-.117-.354-.352V.353c0-.235.118-.353.354-.353h2.431c.234 0 .351.118.351.353v14.343l6.203-6.272c.165-.165.33-.246.495-.246h3.239c.144 0 .236.06.285.18.046.149.034.255-.036.315l-6.555 6.344 6.836 8.507c.095.104.117.208.07.336"/>
                </svg>
              </a>
            )}
            {siteConfig.cv && (
              <a
                href={siteConfig.cv}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Download CV"
                class="w-11 h-11 rounded-xl border border-gray-200 dark:border-white/10 bg-white dark:bg-zinc-800 flex items-center justify-center text-gray-600 dark:text-zinc-400 hover:border-teal-600 dark:hover:border-teal-400 hover:text-teal-700 dark:hover:text-teal-400 dark:hover:bg-white/10 transition-colors"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Right Column: Web3Forms POST Form -->
      <div class="lg:col-span-7 reveal-item" style="--reveal-delay: 80ms;">
        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="bg-white dark:bg-zinc-800 rounded-2xl border border-gray-200 dark:border-white/10 p-6 sm:p-8 shadow-sm space-y-5"
        >
          <!-- Web3Forms configuration fields -->
          <input type="hidden" name="access_key" value="a8c93dfb-2b42-4a0c-914a-aa3c425d2361" />
          <input type="hidden" name="subject" value="New portfolio contact" />
          <input type="hidden" name="from_name" value="Portfolio Contact Form" />
          <input type="hidden" name="redirect" value="https://novrianpratama.my.id/#contact" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <div>
            <label
              for="contact-name"
              data-i18n="contact.nameLabel"
              class="block text-sm font-semibold text-gray-800 dark:text-zinc-100 mb-2"
            >
              Name
            </label>
            <input
              id="contact-name"
              name="name"
              type="text"
              required
              placeholder="Your name"
              data-i18n-placeholder="contact.namePlaceholder"
              class="w-full min-h-[44px] px-4 py-2.5 rounded-xl border border-gray-200 dark:border-white/10 bg-white dark:bg-zinc-900 text-gray-900 dark:text-zinc-100 placeholder-gray-400 dark:placeholder-zinc-500 text-sm focus:outline-none focus:border-teal-600 dark:focus:border-teal-400"
            />
          </div>

          <div>
            <label
              for="contact-email"
              data-i18n="contact.emailLabel"
              class="block text-sm font-semibold text-gray-800 dark:text-zinc-100 mb-2"
            >
              Email
            </label>
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              placeholder="you@example.com"
              data-i18n-placeholder="contact.emailPlaceholder"
              class="w-full min-h-[44px] px-4 py-2.5 rounded-xl border border-gray-200 dark:border-white/10 bg-white dark:bg-zinc-900 text-gray-900 dark:text-zinc-100 placeholder-gray-400 dark:placeholder-zinc-500 text-sm focus:outline-none focus:border-teal-600 dark:focus:border-teal-400"
            />
          </div>

          <div>
            <label
              for="contact-message"
              data-i18n="contact.messageLabel"
              class="block text-sm font-semibold text-gray-800 dark:text-zinc-100 mb-2"
            >
              Message
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              placeholder="Write your message here..."
              data-i18n-placeholder="contact.messagePlaceholder"
              class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-white/10 bg-white dark:bg-zinc-900 text-gray-900 dark:text-zinc-100 placeholder-gray-400 dark:placeholder-zinc-500 text-sm focus:outline-none focus:border-teal-600 dark:focus:border-teal-400 resize-y"
            ></textarea>
          </div>

          <button
            id="contact-submit-btn"
            type="submit"
            class="w-full min-h-[46px] inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold text-white bg-[#0F766E] dark:bg-teal-500 transition-opacity hover:opacity-90 cursor-pointer shadow-sm"
          >
            <span id="contact-submit-text" data-i18n="contact.send">Send message</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M10 14l11 -11" />
              <path d="M21 3l-6.5 18a.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a.55 .55 0 0 1 0 -1l18 -6.5" />
            </svg>
          </button>

          <p
            id="contact-status"
            role="status"
            aria-live="polite"
            class="hidden text-sm font-medium text-teal-700 dark:text-teal-400 text-center pt-1"
          ></p>

          <p class="text-xs text-gray-500 dark:text-zinc-400 text-center pt-1">
            <span data-i18n="contact.orEmailPrefix">Or email me directly at </span>
            <a
              href={`mailto:${siteConfig.social.email}`}
              class="font-medium text-teal-700 dark:text-teal-400 hover:underline"
            >
              {siteConfig.social.email}
            </a>
          </p>
        </form>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("contact-status");
  const submitBtn = document.getElementById("contact-submit-btn") as HTMLButtonElement | null;
  const submitText = document.getElementById("contact-submit-text");

  function t(key: string, fallback: string): string {
    const fn = (window as any).__getPortfolioText;
    return typeof fn === "function" ? fn(key) || fallback : fallback;
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const nameInput = document.getElementById("contact-name") as HTMLInputElement | null;
    const emailInput = document.getElementById("contact-email") as HTMLInputElement | null;
    const messageInput = document.getElementById("contact-message") as HTMLTextAreaElement | null;

    const name = nameInput?.value.trim() || "";
    const email = emailInput?.value.trim() || "";
    const message = messageInput?.value.trim() || "";

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!name || !email || !message || !emailRegex.test(email)) {
      if (statusEl) {
        statusEl.textContent = t(
          "contact.validationError",
          "Please fill in all fields with a valid email address."
        );
        statusEl.classList.remove("hidden");
      }
      return;
    }

    if (submitBtn && submitText) {
      submitBtn.disabled = true;
      submitText.textContent = t("contact.sending", "Sending...");
    }

    try {
      const formData = new FormData(form);
      formData.delete("redirect");
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: {
          Accept: "application/json",
        },
        body: formData,
      });
      const result = await response.json();

      if (response.ok && result.success) {
        form.reset();
        if (statusEl) {
          statusEl.textContent = t(
            "contact.successMsg",
            "Thank you! Your message has been sent successfully."
          );
          statusEl.classList.remove("hidden");
        }
      } else {
        form.submit();
      }
    } catch (err) {
      form.submit();
    } finally {
      if (submitBtn && submitText) {
        submitBtn.disabled = false;
        submitText.textContent = t("contact.send", "Send message");
      }
    }
  });
</script>
