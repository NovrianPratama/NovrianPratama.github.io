---
import { siteConfig } from "../config";
---

<section id="contact" class="px-8 py-16 sm:px-12 sm:py-20 md:px-24 md:py-24">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">

      <!-- Label -->
      <div class="lg:col-span-4">
        <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold text-gray-900">
          Contact
        </h2>
        <div
          class="w-16 h-1.5 mt-3 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        ></div>
      </div>

      <!-- Links -->
      <div class="lg:col-span-8">
        <p class="text-base sm:text-lg text-gray-600 leading-relaxed mb-8 max-w-xl">
          Open to Data Analyst, BI Analyst, and Business Analyst roles — especially in FMCG. Feel free to reach out or view my work.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

          <!-- Email -->
          <a
            href={`mailto:${siteConfig.social.email}`}
            class="group flex items-center gap-4 p-4 rounded-xl border border-gray-200 bg-white hover:border-gray-300 hover:shadow-sm transition-all duration-200"
          >
            <div class="flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center" style={`background-color: ${siteConfig.accentColor}15`}>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={siteConfig.accentColor} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </div>
            <div>
              <p class="text-xs text-gray-400 font-medium">Email</p>
              <p class="text-sm font-semibold text-gray-800 group-hover:text-gray-900">{siteConfig.social.email}</p>
            </div>
          </a>

          <!-- LinkedIn -->
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 p-4 rounded-xl border border-gray-200 bg-white hover:border-gray-300 hover:shadow-sm transition-all duration-200"
          >
            <div class="flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center" style={`background-color: ${siteConfig.accentColor}15`}>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={siteConfig.accentColor} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M8 11v5"></path><path d="M8 8v.01"></path>
                <path d="M12 16v-5"></path>
                <path d="M16 16v-3a2 2 0 1 0 -4 0"></path>
                <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z"></path>
              </svg>
            </div>
            <div>
              <p class="text-xs text-gray-400 font-medium">LinkedIn</p>
              <p class="text-sm font-semibold text-gray-800 group-hover:text-gray-900">novrianpratama</p>
            </div>
          </a>

          <!-- GitHub -->
          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 p-4 rounded-xl border border-gray-200 bg-white hover:border-gray-300 hover:shadow-sm transition-all duration-200"
          >
            <div class="flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center" style={`background-color: ${siteConfig.accentColor}15`}>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={siteConfig.accentColor} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"></path>
              </svg>
            </div>
            <div>
              <p class="text-xs text-gray-400 font-medium">GitHub</p>
              <p class="text-sm font-semibold text-gray-800 group-hover:text-gray-900">NovrianPratama</p>
            </div>
          </a>

          <!-- CV Download -->
          <a
            href={siteConfig.cv}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 p-4 rounded-xl border border-gray-200 bg-white hover:border-gray-300 hover:shadow-sm transition-all duration-200"
          >
            <div class="flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center" style={`background-color: ${siteConfig.accentColor}15`}>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={siteConfig.accentColor} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </div>
            <div>
              <p class="text-xs text-gray-400 font-medium">Curriculum Vitae</p>
              <p class="text-sm font-semibold text-gray-800 group-hover:text-gray-900">Download CV (PDF)</p>
            </div>
          </a>

          <!-- Medium -->
          <a
            href={siteConfig.social.medium}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 p-4 rounded-xl border border-gray-200 bg-white hover:border-gray-300 hover:shadow-sm transition-all duration-200"
          >
            <div class="flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center" style={`background-color: ${siteConfig.accentColor}15`}>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill={siteConfig.accentColor}>
                <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs text-gray-400 font-medium">Medium</p>
              <p class="text-sm font-semibold text-gray-800 group-hover:text-gray-900">@novrianprtama2</p>
            </div>
          </a>

          <!-- Kaggle -->
          <a
            href={siteConfig.social.kaggle}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-4 p-4 rounded-xl border border-gray-200 bg-white hover:border-gray-300 hover:shadow-sm transition-all duration-200"
          >
            <div class="flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center" style={`background-color: ${siteConfig.accentColor}15`}>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill={siteConfig.accentColor}>
                <path d="M18.825 23.859c-.022.092-.117.141-.281.141h-3.139c-.187 0-.351-.082-.492-.248l-5.178-6.589-1.448 1.374v5.111c0 .235-.117.352-.351.352H5.505c-.236 0-.354-.117-.354-.352V.353c0-.235.118-.353.354-.353h2.431c.234 0 .351.118.351.353v14.343l6.203-6.272c.165-.165.33-.246.495-.246h3.239c.144 0 .236.06.285.18.046.149.034.255-.036.315l-6.555 6.344 6.836 8.507c.095.104.117.208.07.336"/>
              </svg>
            </div>
            <div>
              <p class="text-xs text-gray-400 font-medium">Kaggle</p>
              <p class="text-sm font-semibold text-gray-800 group-hover:text-gray-900">novrian02</p>
            </div>
          </a>

        </div>
      </div>

    </div>
  </div>
</section>
