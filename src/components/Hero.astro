---
import { siteConfig } from "../config";
const photoSrc = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${siteConfig.photo.replace(/^\//, "")}`;
---

<div
  id="hero"
  class="relative isolate overflow-hidden bg-white dark:bg-gray-950 pt-24 pb-10 sm:pt-28 sm:pb-12 md:pt-28 md:pb-14 transition-colors duration-200"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <!-- Subtle grid pattern -->
  <svg
    aria-hidden="true"
    class="absolute inset-0 -z-10 size-full stroke-gray-200/70 dark:stroke-gray-800/60"
  >
    <defs>
      <pattern
        x="50%"
        y={-1}
        id="grid-pattern"
        width={200}
        height={200}
        patternUnits="userSpaceOnUse"
      >
        <path d="M.5 200V.5H200" fill="none"></path>
      </pattern>
    </defs>
    <rect fill="url(#grid-pattern)" width="100%" height="100%" stroke-width={0}></rect>
  </svg>

  <!-- Two-column Hero Content -->
  <div class="max-w-6xl mx-auto px-5 sm:px-8 md:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">

      <!-- Left Column: Text, CTAs, Socials -->
      <div class="lg:col-span-7">
        <!-- Location -->
        <p class="text-sm text-gray-500 dark:text-gray-400 font-medium tracking-wide mb-3 animate-fade-in flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          {siteConfig.location}
        </p>

        <!-- Greeting -->
        <h2 class="text-lg sm:text-xl font-medium text-gray-500 dark:text-gray-400 animate-fade-in animation-delay-200">
          Hello!
        </h2>

        <!-- Name -->
        <h1 class="mt-1.5 text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-gray-900 dark:text-gray-100 animate-fade-in animation-delay-400">
          I'm <span style={`color: ${siteConfig.accentColor}`}>{siteConfig.name}</span>
        </h1>

        <!-- Title + tagline -->
        <p class="mt-3 text-lg sm:text-2xl font-semibold text-gray-700 dark:text-gray-200 animate-fade-in animation-delay-400 flex flex-wrap items-center gap-2">
          <span>{siteConfig.title}</span>
          <span class="inline-flex items-center px-3 py-0.5 rounded-full text-xs sm:text-sm font-medium bg-teal-50 text-teal-800 dark:bg-teal-950/80 dark:text-teal-300 border border-teal-200 dark:border-teal-800">
            {siteConfig.tagline}
          </span>
        </p>

        <!-- Subtitle / value prop -->
        <p class="mt-4 text-base sm:text-lg text-gray-600 dark:text-gray-300 leading-relaxed animate-fade-in animation-delay-600 max-w-xl">
          {siteConfig.subtitle}
        </p>

        <!-- CTAs -->
        <div class="mt-6 flex flex-wrap gap-3 sm:gap-4 animate-fade-in animation-delay-800">
          <a
            href={siteConfig.cv}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 min-h-[44px] px-5 py-2.5 rounded-lg font-semibold text-white text-sm transition-all duration-200 hover:opacity-90 shadow-sm"
            style={`background-color: ${siteConfig.accentColor}`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            Download CV
          </a>
          <a
            href="#projects"
            class="inline-flex items-center gap-2 min-h-[44px] px-5 py-2.5 rounded-lg font-semibold text-sm border-2 transition-all duration-200 hover:bg-teal-50/50 dark:hover:bg-teal-950/40 text-teal-700 dark:text-teal-300 border-teal-700 dark:border-teal-500"
          >
            View Projects
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <!-- Social links -->
        <div class="mt-5 flex items-center gap-2 text-gray-500 dark:text-gray-400 animate-fade-in animation-delay-800">
          {siteConfig.social?.email && (
            <a href={`mailto:${siteConfig.social.email}`} aria-label="Email" class="w-11 h-11 inline-flex items-center justify-center rounded-lg transition-colors duration-200 hover:text-[var(--accent-color)] hover:bg-gray-100 dark:hover:bg-gray-900">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </a>
          )}
          {siteConfig.social?.linkedin && (
            <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="w-11 h-11 inline-flex items-center justify-center rounded-lg transition-colors duration-200 hover:text-[var(--accent-color)] hover:bg-gray-100 dark:hover:bg-gray-900">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M8 11v5"></path><path d="M8 8v.01"></path>
                <path d="M12 16v-5"></path>
                <path d="M16 16v-3a2 2 0 1 0 -4 0"></path>
                <path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z"></path>
              </svg>
            </a>
          )}
          {siteConfig.social?.github && (
            <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="w-11 h-11 inline-flex items-center justify-center rounded-lg transition-colors duration-200 hover:text-[var(--accent-color)] hover:bg-gray-100 dark:hover:bg-gray-900">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"></path>
              </svg>
            </a>
          )}
          {siteConfig.social?.medium && (
            <a href={siteConfig.social.medium} target="_blank" rel="noopener noreferrer" aria-label="Medium" class="w-11 h-11 inline-flex items-center justify-center rounded-lg transition-colors duration-200 hover:text-[var(--accent-color)] hover:bg-gray-100 dark:hover:bg-gray-900">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
              </svg>
            </a>
          )}
          {siteConfig.social?.kaggle && (
            <a href={siteConfig.social.kaggle} target="_blank" rel="noopener noreferrer" aria-label="Kaggle" class="w-11 h-11 inline-flex items-center justify-center rounded-lg transition-colors duration-200 hover:text-[var(--accent-color)] hover:bg-gray-100 dark:hover:bg-gray-900">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.825 23.859c-.022.092-.117.141-.281.141h-3.139c-.187 0-.351-.082-.492-.248l-5.178-6.589-1.448 1.374v5.111c0 .235-.117.352-.351.352H5.505c-.236 0-.354-.117-.354-.352V.353c0-.235.118-.353.354-.353h2.431c.234 0 .351.118.351.353v14.343l6.203-6.272c.165-.165.33-.246.495-.246h3.239c.144 0 .236.06.285.18.046.149.034.255-.036.315l-6.555 6.344 6.836 8.507c.095.104.117.208.07.336"/>
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Right Column: Portrait Photo + Name Card Overlay -->
      {siteConfig.photo && (
        <div class="lg:col-span-5 flex justify-center lg:justify-end animate-fade-in animation-delay-400">
          <div class="relative w-64 sm:w-72 md:w-80 pb-4 pl-4">
            <!-- Subtle offset frame behind photo -->
            <div
              class="absolute top-3 right-0 bottom-1 left-7 rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 -z-10"
            ></div>

            <!-- Main Portrait Photo -->
            <div class="overflow-hidden rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-100 dark:bg-gray-900 shadow-md aspect-[4/5]">
              <img
                src={photoSrc}
                alt={siteConfig.name}
                width="360"
                height="450"
                class="w-full h-full object-cover object-top"
                loading="eager"
              />
            </div>

            <!-- Small Overlay Card at Bottom-Left Corner -->
            <div class="absolute bottom-0 left-0 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl px-4 py-3 shadow-md">
              <p class="text-[11px] font-semibold uppercase tracking-widest text-gray-500 dark:text-gray-400">
                {siteConfig.name}
              </p>
              <p class="text-sm font-bold text-teal-700 dark:text-teal-400 mt-0.5">
                {siteConfig.title}
              </p>
            </div>
          </div>
        </div>
      )}

    </div>
  </div>
</div>
