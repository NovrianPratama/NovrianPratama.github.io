---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{hasEducation && (
  <section id="education" class="px-5 py-12 sm:px-8 sm:py-16 md:px-12 md:py-20 bg-white dark:bg-zinc-900 transition-colors duration-200">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">

        <!-- Label -->
        <div class="lg:col-span-4 reveal-item">
          <h2
            data-i18n="education.heading"
            class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-zinc-100"
          >
            Education
          </h2>
          <div class="w-14 h-1.5 mt-2.5 rounded-full bg-[#0F766E] dark:bg-teal-400"></div>
        </div>

        <!-- Education entries -->
        <div class="lg:col-span-8 space-y-5">
          {siteConfig.education.map((edu, idx) => (
            <div
              style={`--reveal-delay: ${Math.min(idx * 90, 240)}ms;`}
              class="reveal-item bg-gray-50 dark:bg-zinc-800 rounded-xl border border-gray-200 dark:border-white/10 p-5 sm:p-6 shadow-sm"
            >
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-3">
                <div>
                  <h3
                    data-i18n={`education.${idx}.degree`}
                    class="text-base sm:text-lg font-semibold text-gray-900 dark:text-zinc-100"
                  >
                    {edu.degree}
                  </h3>
                  <p
                    data-i18n={`education.${idx}.school`}
                    class="text-sm sm:text-base font-medium mt-0.5 text-teal-700 dark:text-teal-400"
                  >
                    {edu.school}
                  </p>
                </div>
                <div class="sm:text-right flex-shrink-0">
                  <p class="text-xs sm:text-sm text-gray-500 dark:text-zinc-400 whitespace-nowrap">
                    {edu.dateRange}
                  </p>
                  {edu.location && (
                    <p
                      data-i18n={`education.${idx}.location`}
                      class="text-xs text-gray-400 dark:text-zinc-500"
                    >
                      {edu.location}
                    </p>
                  )}
                </div>
              </div>

              {edu.achievements && edu.achievements.length > 0 && (
                <ul class="space-y-2">
                  {edu.achievements.map((item, aIdx) => (
                    <li class="flex items-start gap-2.5">
                      <span class="inline-block w-1.5 h-1.5 rounded-full mt-2 flex-shrink-0 bg-[#0F766E] dark:bg-teal-400"></span>
                      <span
                        data-i18n={`education.${idx}.achievement.${aIdx}`}
                        class="text-sm text-gray-600 dark:text-zinc-400 leading-relaxed"
                      >
                        {item}
                      </span>
                    </li>
                  ))}
                </ul>
              )}

              {edu.thesis && (
                <div class="mt-4 pt-3.5 border-t border-gray-200/80 dark:border-white/10">
                  <p
                    data-i18n={`education.${idx}.thesis.label`}
                    class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-zinc-400 mb-1"
                  >
                    {edu.thesis.label}
                  </p>
                  <a
                    href={edu.thesis.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-start gap-1.5 text-sm font-medium text-[#0F766E] dark:text-teal-400 hover:underline leading-relaxed"
                  >
                    <span data-i18n={`education.${idx}.thesis.title`}>{edu.thesis.title}</span>
                    <!-- Tabler external-link icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-1" aria-hidden="true">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                      <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" />
                      <path d="M11 13l9 -9" />
                      <path d="M15 4h5v5" />
                    </svg>
                  </a>
                </div>
              )}
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>
)}
