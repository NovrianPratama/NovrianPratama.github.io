---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{hasEducation && (
  <section id="education" class="px-5 py-12 sm:px-8 sm:py-16 md:px-12 md:py-20 bg-white dark:bg-zinc-900 transition-colors duration-200">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">

        <!-- Label -->
        <div class="lg:col-span-4">
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-zinc-100">
            Education
          </h2>
          <div class="w-14 h-1.5 mt-2.5 rounded-full bg-[#0F766E] dark:bg-teal-400"></div>
        </div>

        <!-- Education entries -->
        <div class="lg:col-span-8 space-y-5">
          {siteConfig.education.map((edu) => (
            <div class="bg-gray-50 dark:bg-zinc-800 rounded-xl border border-gray-200 dark:border-white/10 p-5 sm:p-6 shadow-sm">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-3">
                <div>
                  <h3 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-zinc-100">{edu.degree}</h3>
                  <p class="text-sm sm:text-base font-medium mt-0.5 text-teal-700 dark:text-teal-400">
                    {edu.school}
                  </p>
                </div>
                <span class="text-xs sm:text-sm text-gray-500 dark:text-zinc-400 whitespace-nowrap flex-shrink-0">{edu.dateRange}</span>
              </div>

              {edu.achievements && edu.achievements.length > 0 && (
                <ul class="space-y-1.5">
                  {edu.achievements.map((item) => (
                    <li class="flex items-start gap-2.5">
                      <span class="inline-block w-1.5 h-1.5 rounded-full mt-2 flex-shrink-0 bg-[#0F766E] dark:bg-teal-400"></span>
                      <span class="text-sm text-gray-600 dark:text-zinc-400">{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>
)}
