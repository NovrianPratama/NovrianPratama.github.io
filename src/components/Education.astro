---
import { siteConfig } from "../config";
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

{hasEducation && (
  <section id="education" class="px-8 py-16 sm:px-12 sm:py-20 md:px-24 md:py-24 bg-gray-50">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">

        <!-- Label -->
        <div class="lg:col-span-4">
          <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold text-gray-900">
            Education
          </h2>
          <div
            class="w-16 h-1.5 mt-3 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          ></div>
        </div>

        <!-- Education entries -->
        <div class="lg:col-span-8 space-y-6">
          {siteConfig.education.map((edu) => (
            <div class="bg-white rounded-xl border border-gray-100 p-6 shadow-sm">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-4">
                <div>
                  <h3 class="text-base sm:text-lg font-semibold text-gray-900">{edu.degree}</h3>
                  <p class="text-sm sm:text-base font-medium mt-0.5" style={`color: ${siteConfig.accentColor}`}>
                    {edu.school}
                  </p>
                </div>
                <span class="text-xs sm:text-sm text-gray-500 whitespace-nowrap flex-shrink-0">{edu.dateRange}</span>
              </div>

              {edu.achievements && edu.achievements.length > 0 && (
                <ul class="space-y-1.5">
                  {edu.achievements.map((item) => (
                    <li class="flex items-start gap-2.5">
                      <span
                        class="inline-block w-1.5 h-1.5 rounded-full mt-2 flex-shrink-0"
                        style={`background-color: ${siteConfig.accentColor}`}
                      ></span>
                      <span class="text-sm text-gray-600">{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>
)}
