---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasSkills = siteConfig.skillGroups && siteConfig.skillGroups.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
const hasCertifications = siteConfig.certifications && siteConfig.certifications.length > 0;
const hasOrganizations = siteConfig.organizations && siteConfig.organizations.length > 0;
const hasAwards = siteConfig.awards && siteConfig.awards.length > 0;
const avatarSrc = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${siteConfig.photo.replace(/^\//, "")}`;

const navItems = [
  { id: "about", label: "About", href: "#about", show: true },
  { id: "experience", label: "Experience", href: "#experience", show: hasExperience },
  { id: "projects", label: "Projects", href: "#projects", show: hasProjects },
  { id: "skills", label: "Skills", href: "#skills", show: hasSkills },
  { id: "education", label: "Education", href: "#education", show: hasEducation },
  { id: "certifications", label: "Certifications", href: "#certifications", show: hasCertifications },
  { id: "organizations", label: "Organizations", href: "#organizations", show: hasOrganizations },
  { id: "awards", label: "Awards", href: "#awards", show: hasAwards },
  { id: "contact", label: "Contact", href: "#contact", show: true },
].filter((item) => item.show);
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 w-full z-50 bg-white/80 dark:bg-zinc-900/80 backdrop-blur-md border-b border-gray-200/80 dark:border-white/10 transition-colors duration-200"
>
  <div class="max-w-6xl mx-auto w-full px-5 sm:px-8 lg:px-6 xl:px-8 py-3 flex items-center justify-between gap-2 xl:gap-3">
    <!-- Far Left: Circular Photo Avatar + "RYAN" Only -->
    <a
      href="#hero"
      aria-label={siteConfig.name}
      class="flex items-center gap-3 text-gray-900 dark:text-zinc-100 hover:opacity-85 transition-opacity flex-shrink-0"
    >
      <img
        src={avatarSrc}
        alt={siteConfig.name}
        width="44"
        height="44"
        class="w-11 h-11 rounded-full object-cover object-top ring-2 ring-gray-200 dark:ring-white/15 flex-shrink-0"
      />
      <span class="text-sm sm:text-base font-bold tracking-widest uppercase leading-none text-gray-900 dark:text-zinc-100">
        RYAN
      </span>
    </a>

    <!-- Center: Desktop Single Glass Pill Bar (all 9 links fit fully inside the pill) -->
    <nav
      aria-label="Primary navigation"
      class="hidden lg:inline-flex items-center gap-0.5 flex-shrink-0 rounded-full p-1.5 bg-white/70 dark:bg-white/10 border border-neutral-200/80 dark:border-white/15 backdrop-blur-xl backdrop-saturate-150 shadow-[0_8px_24px_rgba(15,23,42,0.08),inset_0_1px_0_rgba(255,255,255,0.85)] dark:shadow-[0_8px_28px_rgba(0,0,0,0.35),inset_0_1px_0_rgba(255,255,255,0.2)]"
    >
      {navItems.map((item, idx) => {
        const isDefaultActive = idx === 0;
        return (
          <a
            href={item.href}
            data-nav-id={item.id}
            aria-current={isDefaultActive ? "page" : undefined}
            class:list={[
              "desktop-nav-pill group relative inline-flex items-center justify-center gap-1 min-h-[40px] rounded-full px-2.5 py-1.5 text-xs font-medium transition-all duration-200 whitespace-nowrap flex-shrink-0",
              isDefaultActive
                ? "is-active bg-[#0F766E] dark:bg-teal-500 text-white shadow-[0_0_14px_rgba(15,118,110,0.4),inset_0_1px_0_rgba(255,255,255,0.3)] dark:shadow-[0_0_16px_rgba(20,184,166,0.45),inset_0_1px_0_rgba(255,255,255,0.3)]"
                : "text-gray-700 dark:text-zinc-100/85 hover:bg-neutral-900/5 dark:hover:bg-white/10 hover:text-gray-900 dark:hover:text-zinc-100",
            ]}
          >
            {item.id === "about" && (
              <svg class="w-3.5 h-3.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
              </svg>
            )}
            {item.id === "experience" && (
              <svg class="w-3.5 h-3.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M3 7m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z" />
                <path d="M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2" />
                <path d="M12 12l0 .01" />
                <path d="M3 13a20 20 0 0 0 18 0" />
              </svg>
            )}
            {item.id === "projects" && (
              <svg class="w-3.5 h-3.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M4 4m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" />
                <path d="M14 4m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" />
                <path d="M4 14m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" />
                <path d="M14 14m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" />
              </svg>
            )}
            {item.id === "skills" && (
              <svg class="w-3.5 h-3.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M7 8l-4 4l4 4" />
                <path d="M17 8l4 4l-4 4" />
                <path d="M14 4l-4 16" />
              </svg>
            )}
            {item.id === "education" && (
              <svg class="w-3.5 h-3.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M22 9l-10 -4l-10 4l10 4l10 -4v6" />
                <path d="M6 10.6v5.4a6 3 0 0 0 12 0v-5.4" />
              </svg>
            )}
            {item.id === "certifications" && (
              <svg class="w-3.5 h-3.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M15 15m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                <path d="M13 17.5v4.5l2 -1.5l2 1.5v-4.5" />
                <path d="M10 19h-5a2 2 0 0 1 -2 -2v-10c0 -1.1 .9 -2 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -1 1.73" />
                <path d="M6 9l12 0" />
                <path d="M6 12l3 0" />
                <path d="M6 15l2 0" />
              </svg>
            )}
            {item.id === "organizations" && (
              <svg class="w-3.5 h-3.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M10 13a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                <path d="M8 21v-1a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v1" />
                <path d="M15 5a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                <path d="M17 10h2a2 2 0 0 1 2 2v1" />
                <path d="M5 5a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                <path d="M3 13v-1a2 2 0 0 1 2 -2h2" />
              </svg>
            )}
            {item.id === "awards" && (
              <svg class="w-3.5 h-3.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M8 21l8 0" />
                <path d="M12 17l0 4" />
                <path d="M7 4l10 0" />
                <path d="M17 4v8a5 5 0 0 1 -10 0v-8" />
                <path d="M5 9m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                <path d="M19 9m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
              </svg>
            )}
            {item.id === "contact" && (
              <svg class="w-3.5 h-3.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                <path d="M3 7l9 6l9 -6" />
              </svg>
            )}
            <span>{item.label}</span>
          </a>
        );
      })}
    </nav>

    <!-- Right Controls: 44px Theme Toggle + Mobile Hamburger -->
    <div class="flex items-center gap-2 flex-shrink-0">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="w-11 h-11 min-w-[44px] min-h-[44px] inline-flex items-center justify-center rounded-full bg-white/70 dark:bg-white/10 border border-neutral-200/80 dark:border-white/15 backdrop-blur-xl text-gray-700 dark:text-zinc-100 hover:bg-neutral-900/5 dark:hover:bg-white/15 transition-colors cursor-pointer shadow-sm"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg class="hidden dark:block w-5 h-5 text-teal-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
          <path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="block dark:hidden w-5 h-5 text-gray-700" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z" />
        </svg>
      </button>

      <button
        id="mobile-menu-open"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
        class="lg:hidden w-11 h-11 min-w-[44px] min-h-[44px] inline-flex items-center justify-center rounded-full bg-white/70 dark:bg-white/10 border border-neutral-200/80 dark:border-white/15 backdrop-blur-xl text-gray-700 dark:text-zinc-100 hover:bg-neutral-900/5 dark:hover:bg-white/15 transition-colors cursor-pointer shadow-sm"
      >
        <!-- Tabler menu-2 icon -->
        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M4 6l16 0" />
          <path d="M4 12l16 0" />
          <path d="M4 18l16 0" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Glass Menu Panel -->
  <div
    id="mobile-menu-panel"
    class="hidden lg:hidden px-5 sm:px-8 pb-4 pt-1 max-w-6xl mx-auto"
  >
    <div class="rounded-2xl p-3 bg-white/85 dark:bg-zinc-800/90 border border-neutral-200/80 dark:border-white/15 backdrop-blur-xl backdrop-saturate-150 shadow-[0_12px_32px_rgba(15,23,42,0.12),inset_0_1px_0_rgba(255,255,255,0.85)] dark:shadow-[0_12px_32px_rgba(0,0,0,0.45),inset_0_1px_0_rgba(255,255,255,0.15)] max-h-[80vh] overflow-y-auto">
      <div class="flex items-center justify-between px-2 pb-2 mb-2 border-b border-gray-200/70 dark:border-white/10">
        <span class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-zinc-400">Navigation</span>
        <button
          id="mobile-menu-close"
          type="button"
          aria-label="Close menu"
          class="w-11 h-11 min-w-[44px] min-h-[44px] inline-flex items-center justify-center rounded-full text-gray-600 dark:text-zinc-300 hover:bg-neutral-900/5 dark:hover:bg-white/10 transition-colors cursor-pointer"
        >
          <!-- Tabler x icon -->
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M18 6l-12 12" />
            <path d="M6 6l12 12" />
          </svg>
        </button>
      </div>
      <ul class="flex flex-col space-y-1">
        {navItems.map((item, idx) => {
          const isDefaultActive = idx === 0;
          return (
            <li>
              <a
                href={item.href}
                data-mobile-nav-id={item.id}
                aria-current={isDefaultActive ? "page" : undefined}
                class:list={[
                  "mobile-nav-link flex items-center gap-3 min-h-[44px] px-3.5 py-2 rounded-xl text-sm font-medium transition-all duration-200",
                  isDefaultActive
                    ? "is-active bg-[#0F766E] dark:bg-teal-500 text-white shadow-[0_0_12px_rgba(15,118,110,0.35)] dark:shadow-[0_0_14px_rgba(20,184,166,0.4)]"
                    : "text-gray-700 dark:text-zinc-100 hover:bg-neutral-900/5 dark:hover:bg-white/10",
                ]}
              >
                {item.id === "about" && (
                  <svg class="w-4 h-4 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                    <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                  </svg>
                )}
                {item.id === "experience" && (
                  <svg class="w-4 h-4 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M3 7m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z" />
                    <path d="M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2" />
                    <path d="M12 12l0 .01" />
                    <path d="M3 13a20 20 0 0 0 18 0" />
                  </svg>
                )}
                {item.id === "projects" && (
                  <svg class="w-4 h-4 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M4 4m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" />
                    <path d="M14 4m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" />
                    <path d="M4 14m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" />
                    <path d="M14 14m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" />
                  </svg>
                )}
                {item.id === "skills" && (
                  <svg class="w-4 h-4 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M7 8l-4 4l4 4" />
                    <path d="M17 8l4 4l-4 4" />
                    <path d="M14 4l-4 16" />
                  </svg>
                )}
                {item.id === "education" && (
                  <svg class="w-4 h-4 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M22 9l-10 -4l-10 4l10 4l10 -4v6" />
                    <path d="M6 10.6v5.4a6 3 0 0 0 12 0v-5.4" />
                  </svg>
                )}
                {item.id === "certifications" && (
                  <svg class="w-4 h-4 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M15 15m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                    <path d="M13 17.5v4.5l2 -1.5l2 1.5v-4.5" />
                    <path d="M10 19h-5a2 2 0 0 1 -2 -2v-10c0 -1.1 .9 -2 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -1 1.73" />
                    <path d="M6 9l12 0" />
                    <path d="M6 12l3 0" />
                    <path d="M6 15l2 0" />
                  </svg>
                )}
                {item.id === "organizations" && (
                  <svg class="w-4 h-4 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M10 13a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                    <path d="M8 21v-1a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v1" />
                    <path d="M15 5a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                    <path d="M17 10h2a2 2 0 0 1 2 2v1" />
                    <path d="M5 5a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                    <path d="M3 13v-1a2 2 0 0 1 2 -2h2" />
                  </svg>
                )}
                {item.id === "awards" && (
                  <svg class="w-4 h-4 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M8 21l8 0" />
                    <path d="M12 17l0 4" />
                    <path d="M7 4l10 0" />
                    <path d="M17 4v8a5 5 0 0 1 -10 0v-8" />
                    <path d="M5 9m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                    <path d="M19 9m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                  </svg>
                )}
                {item.id === "contact" && (
                  <svg class="w-4 h-4 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                    <path d="M3 7l9 6l9 -6" />
                  </svg>
                )}
                <span>{item.label}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</header>

<script>
  const themeToggle = document.getElementById("theme-toggle");
  const menuOpenBtn = document.getElementById("mobile-menu-open");
  const menuCloseBtn = document.getElementById("mobile-menu-close");
  const menuPanel = document.getElementById("mobile-menu-panel");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");
  const desktopPills = document.querySelectorAll<HTMLAnchorElement>(".desktop-nav-pill[data-nav-id]");
  const mobilePills = document.querySelectorAll<HTMLAnchorElement>(".mobile-nav-link[data-mobile-nav-id]");

  const DESKTOP_ACTIVE = [
    "is-active",
    "bg-[#0F766E]",
    "dark:bg-teal-500",
    "text-white",
    "shadow-[0_0_14px_rgba(15,118,110,0.4),inset_0_1px_0_rgba(255,255,255,0.3)]",
    "dark:shadow-[0_0_16px_rgba(20,184,166,0.45),inset_0_1px_0_rgba(255,255,255,0.3)]",
  ];
  const DESKTOP_INACTIVE = [
    "text-gray-700",
    "dark:text-zinc-100/85",
    "hover:bg-neutral-900/5",
    "dark:hover:bg-white/10",
    "hover:text-gray-900",
    "dark:hover:text-zinc-100",
  ];

  const MOBILE_ACTIVE = [
    "is-active",
    "bg-[#0F766E]",
    "dark:bg-teal-500",
    "text-white",
    "shadow-[0_0_12px_rgba(15,118,110,0.35)]",
    "dark:shadow-[0_0_14px_rgba(20,184,166,0.4)]",
  ];
  const MOBILE_INACTIVE = [
    "text-gray-700",
    "dark:text-zinc-100",
    "hover:bg-neutral-900/5",
    "dark:hover:bg-white/10",
  ];

  function setActiveSection(sectionId: string) {
    desktopPills.forEach((pill) => {
      const isMatch = pill.dataset.navId === sectionId;
      if (isMatch) {
        pill.classList.remove(...DESKTOP_INACTIVE);
        pill.classList.add(...DESKTOP_ACTIVE);
        pill.setAttribute("aria-current", "page");
      } else {
        pill.classList.remove(...DESKTOP_ACTIVE);
        pill.classList.add(...DESKTOP_INACTIVE);
        pill.removeAttribute("aria-current");
      }
    });

    mobilePills.forEach((pill) => {
      const isMatch = pill.dataset.mobileNavId === sectionId;
      if (isMatch) {
        pill.classList.remove(...MOBILE_INACTIVE);
        pill.classList.add(...MOBILE_ACTIVE);
        pill.setAttribute("aria-current", "page");
      } else {
        pill.classList.remove(...MOBILE_ACTIVE);
        pill.classList.add(...MOBILE_INACTIVE);
        pill.removeAttribute("aria-current");
      }
    });
  }

  desktopPills.forEach((pill) => {
    pill.addEventListener("click", () => {
      if (pill.dataset.navId) {
        setActiveSection(pill.dataset.navId);
      }
    });
  });

  mobilePills.forEach((pill) => {
    pill.addEventListener("click", () => {
      if (pill.dataset.mobileNavId) {
        setActiveSection(pill.dataset.mobileNavId);
      }
    });
  });

  // Scroll-spy using IntersectionObserver
  const sectionIds = Array.from(desktopPills)
    .map((p) => p.dataset.navId)
    .filter((id): id is string => Boolean(id));

  if ("IntersectionObserver" in window && sectionIds.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (visible.length > 0 && visible[0].target.id) {
          setActiveSection(visible[0].target.id);
        }
      },
      {
        rootMargin: "-20% 0px -60% 0px",
        threshold: [0, 0.25, 0.5],
      }
    );

    sectionIds.forEach((id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }

  function closeMobileMenu() {
    if (!menuPanel || !menuOpenBtn) return;
    menuPanel.classList.add("hidden");
    menuOpenBtn.setAttribute("aria-expanded", "false");
  }

  function openMobileMenu() {
    if (!menuPanel || !menuOpenBtn) return;
    menuPanel.classList.remove("hidden");
    menuOpenBtn.setAttribute("aria-expanded", "true");
  }

  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("theme", isDark ? "dark" : "light");
    } catch (e) {}
  });

  menuOpenBtn?.addEventListener("click", () => {
    const isExpanded = menuOpenBtn.getAttribute("aria-expanded") === "true";
    if (isExpanded) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  });

  menuCloseBtn?.addEventListener("click", () => {
    closeMobileMenu();
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      closeMobileMenu();
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeMobileMenu();
    }
  });
</script>
