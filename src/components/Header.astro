---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasSkills = siteConfig.skillGroups && siteConfig.skillGroups.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
const hasCertifications = siteConfig.certifications && siteConfig.certifications.length > 0;
const hasOrganizations = siteConfig.organizations && siteConfig.organizations.length > 0;
const hasAwards = siteConfig.awards && siteConfig.awards.length > 0;
const avatarSrc = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${siteConfig.photo.replace(/^\//, "")}`;
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 bg-white/95 dark:bg-gray-950/95 backdrop-blur-sm border-b border-gray-200 dark:border-gray-800 transition-colors duration-200"
>
  <nav class="max-w-6xl mx-auto px-5 sm:px-8 md:px-12 py-3 flex items-center justify-between gap-4">
    <!-- Avatar + Name -->
    <a href="#hero" class="flex items-center gap-3 text-sm font-semibold text-gray-900 dark:text-gray-100 hover:opacity-80 transition-opacity flex-shrink-0">
      <img
        src={avatarSrc}
        alt={siteConfig.name}
        width="38"
        height="38"
        class="w-9 h-9 sm:w-10 sm:h-10 rounded-full object-cover object-top ring-2 ring-gray-200 dark:ring-gray-700"
      />
      <span class="hidden xl:inline">{siteConfig.name}</span>
    </a>

    <!-- Desktop Nav links -->
    <ul class="hidden lg:flex items-center gap-4 xl:gap-5">
      <li>
        <a href="#about" class="text-xs xl:text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors font-medium py-2">
          About
        </a>
      </li>
      {hasExperience && (
        <li>
          <a href="#experience" class="text-xs xl:text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors font-medium py-2">
            Experience
          </a>
        </li>
      )}
      {hasProjects && (
        <li>
          <a href="#projects" class="text-xs xl:text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors font-medium py-2">
            Projects
          </a>
        </li>
      )}
      {hasSkills && (
        <li>
          <a href="#skills" class="text-xs xl:text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors font-medium py-2">
            Skills
          </a>
        </li>
      )}
      {hasEducation && (
        <li>
          <a href="#education" class="text-xs xl:text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors font-medium py-2">
            Education
          </a>
        </li>
      )}
      {hasCertifications && (
        <li>
          <a href="#certifications" class="text-xs xl:text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors font-medium py-2">
            Certifications
          </a>
        </li>
      )}
      {hasOrganizations && (
        <li>
          <a href="#organizations" class="text-xs xl:text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors font-medium py-2">
            Organizations
          </a>
        </li>
      )}
      {hasAwards && (
        <li>
          <a href="#awards" class="text-xs xl:text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors font-medium py-2">
            Awards
          </a>
        </li>
      )}
      <li>
        <a href="#contact" class="text-xs xl:text-sm text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors font-medium py-2">
          Contact
        </a>
      </li>
      <li>
        <a
          href={siteConfig.cv}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center min-h-[40px] px-3.5 py-1.5 rounded-lg text-xs xl:text-sm font-semibold text-white transition-opacity duration-200 hover:opacity-90"
          style={`background-color: ${siteConfig.accentColor}`}
        >
          CV
        </a>
      </li>
    </ul>

    <!-- Right controls: Theme Toggle + Mobile Hamburger -->
    <div class="flex items-center gap-2 flex-shrink-0">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="w-11 h-11 inline-flex items-center justify-center rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors cursor-pointer"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg class="hidden dark:block w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
          <path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7" />
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="block dark:hidden w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z" />
        </svg>
      </button>

      <button
        id="mobile-menu-open"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu-panel"
        class="lg:hidden w-11 h-11 inline-flex items-center justify-center rounded-lg text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors cursor-pointer"
      >
        <!-- Tabler menu-2 icon -->
        <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M4 6l16 0" />
          <path d="M4 12l16 0" />
          <path d="M4 18l16 0" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu panel -->
  <div
    id="mobile-menu-panel"
    class="hidden lg:hidden border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 px-5 pt-3 pb-6 shadow-lg max-h-[80vh] overflow-y-auto"
  >
    <div class="flex items-center justify-between pb-3 mb-2 border-b border-gray-100 dark:border-gray-800">
      <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-gray-500">Navigation</span>
      <button
        id="mobile-menu-close"
        type="button"
        aria-label="Close menu"
        class="w-11 h-11 inline-flex items-center justify-center rounded-lg text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors cursor-pointer"
      >
        <!-- Tabler x icon -->
        <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M18 6l-12 12" />
          <path d="M6 6l12 12" />
        </svg>
      </button>
    </div>
    <ul class="flex flex-col space-y-1">
      <li>
        <a href="#about" class="mobile-nav-link flex items-center min-h-[44px] px-3 rounded-lg text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-900">
          About
        </a>
      </li>
      {hasExperience && (
        <li>
          <a href="#experience" class="mobile-nav-link flex items-center min-h-[44px] px-3 rounded-lg text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-900">
            Experience
          </a>
        </li>
      )}
      {hasProjects && (
        <li>
          <a href="#projects" class="mobile-nav-link flex items-center min-h-[44px] px-3 rounded-lg text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-900">
            Projects
          </a>
        </li>
      )}
      {hasSkills && (
        <li>
          <a href="#skills" class="mobile-nav-link flex items-center min-h-[44px] px-3 rounded-lg text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-900">
            Skills
          </a>
        </li>
      )}
      {hasEducation && (
        <li>
          <a href="#education" class="mobile-nav-link flex items-center min-h-[44px] px-3 rounded-lg text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-900">
            Education
          </a>
        </li>
      )}
      {hasCertifications && (
        <li>
          <a href="#certifications" class="mobile-nav-link flex items-center min-h-[44px] px-3 rounded-lg text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-900">
            Certifications
          </a>
        </li>
      )}
      {hasOrganizations && (
        <li>
          <a href="#organizations" class="mobile-nav-link flex items-center min-h-[44px] px-3 rounded-lg text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-900">
            Organizations
          </a>
        </li>
      )}
      {hasAwards && (
        <li>
          <a href="#awards" class="mobile-nav-link flex items-center min-h-[44px] px-3 rounded-lg text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-900">
            Awards
          </a>
        </li>
      )}
      <li>
        <a href="#contact" class="mobile-nav-link flex items-center min-h-[44px] px-3 rounded-lg text-base font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-900">
          Contact
        </a>
      </li>
      <li class="pt-2">
        <a
          href={siteConfig.cv}
          target="_blank"
          rel="noopener noreferrer"
          class="mobile-nav-link flex items-center justify-center min-h-[44px] px-4 rounded-lg text-base font-semibold text-white transition-opacity hover:opacity-90"
          style={`background-color: ${siteConfig.accentColor}`}
        >
          CV
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const themeToggle = document.getElementById("theme-toggle");
  const menuOpenBtn = document.getElementById("mobile-menu-open");
  const menuCloseBtn = document.getElementById("mobile-menu-close");
  const menuPanel = document.getElementById("mobile-menu-panel");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");

  function closeMobileMenu() {
    if (!menuPanel || !menuOpenBtn) return;
    menuPanel.classList.add("hidden");
    menuOpenBtn.setAttribute("aria-expanded", "false");
  }

  function openMobileMenu() {
    if (!menuPanel || !menuOpenBtn) return;
    menuPanel.classList.remove("hidden");
    menuOpenBtn.setAttribute("aria-expanded", "true");
  }

  themeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("theme", isDark ? "dark" : "light");
    } catch (e) {}
  });

  menuOpenBtn?.addEventListener("click", () => {
    const isExpanded = menuOpenBtn.getAttribute("aria-expanded") === "true";
    if (isExpanded) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  });

  menuCloseBtn?.addEventListener("click", () => {
    closeMobileMenu();
  });

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      closeMobileMenu();
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeMobileMenu();
    }
  });
</script>
