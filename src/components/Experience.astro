---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{hasExperience && (
  <section id="experience" class="px-5 py-12 sm:px-8 sm:py-16 md:px-12 md:py-20 bg-gray-50 dark:bg-zinc-900 transition-colors duration-200">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">

        <!-- Label -->
        <div class="lg:col-span-4 reveal-item">
          <h2
            data-i18n="experience.heading"
            class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-zinc-100"
          >
            Experience
          </h2>
          <div class="w-14 h-1.5 mt-2.5 rounded-full bg-[#0F766E] dark:bg-teal-400"></div>
        </div>

        <!-- Experience timeline -->
        <div class="lg:col-span-8">
          <div class="relative">
            {siteConfig.experience.map((exp, index) => (
              <div
                style={`--reveal-delay: ${Math.min(index * 80, 240)}ms;`}
                class="relative mb-6 last:mb-0 reveal-item"
              >
                <!-- Timeline dot -->
                <div class="absolute left-1/2 -top-2 w-3.5 h-3.5 rounded-full -translate-x-1/2 z-20 bg-[#0F766E] dark:bg-teal-400"></div>

                <!-- Connector line -->
                {index < siteConfig.experience.length - 1 && (
                  <div class="absolute left-1/2 bottom-0 w-px h-6 bg-gray-200 dark:bg-white/10 -translate-x-1/2 translate-y-full z-10"></div>
                )}

                <!-- Card -->
                <div class="bg-white dark:bg-zinc-800 rounded-xl border border-gray-200 dark:border-white/10 p-5 sm:p-6 shadow-sm hover:shadow-md transition-shadow duration-200">
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1 mb-3">
                    <div>
                      <h3
                        data-i18n={`experience.${index}.title`}
                        class="text-base sm:text-lg font-semibold text-gray-900 dark:text-zinc-100"
                      >
                        {exp.title}
                      </h3>
                      <p class="text-sm sm:text-base font-medium mt-0.5 text-teal-700 dark:text-teal-400">
                        {exp.company}
                      </p>
                    </div>
                    <span class="text-xs sm:text-sm text-gray-500 dark:text-zinc-400 whitespace-nowrap flex-shrink-0">{exp.dateRange}</span>
                  </div>

                  <ul class="space-y-2">
                    {exp.bullets.map((bullet, bIdx) => (
                      <li class="flex items-start gap-2.5">
                        <span class="inline-block w-1.5 h-1.5 rounded-full mt-2 flex-shrink-0 bg-[#0F766E] dark:bg-teal-400"></span>
                        <span
                          data-i18n={`experience.${index}.bullet.${bIdx}`}
                          class="text-sm text-gray-600 dark:text-zinc-400 leading-relaxed"
                        >
                          {bullet}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>
)}
