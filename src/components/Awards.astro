---
import { siteConfig } from "../config";
const hasAwards = siteConfig.awards && siteConfig.awards.length > 0;
---

{hasAwards && (
  <section id="awards" class="px-5 py-12 sm:px-8 sm:py-16 md:px-12 md:py-20 bg-gray-50 dark:bg-zinc-900 transition-colors duration-200">
    <div class="max-w-6xl mx-auto">
      <!-- Section Header -->
      <div class="mb-6">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-zinc-100">
          Awards
        </h2>
        <div class="w-14 h-1.5 mt-2.5 rounded-full bg-[#0F766E] dark:bg-teal-400"></div>
      </div>

      <!-- Year Filter Buttons (2025, 2024, 2023) -->
      <div class="flex flex-wrap items-center gap-2 mb-8" role="group" aria-label="Filter awards by year">
        {siteConfig.awards.map((group, idx) => {
          const isDefault = idx === 0;
          return (
            <button
              type="button"
              data-award-year-btn={group.year}
              aria-pressed={isDefault ? "true" : "false"}
              class:list={[
                "award-year-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold border transition-all duration-200 cursor-pointer",
                isDefault
                  ? "bg-[#0F766E] dark:bg-teal-500 text-white border-[#0F766E] dark:border-teal-500 shadow-sm"
                  : "bg-white dark:bg-zinc-800 text-gray-700 dark:text-zinc-400 border-gray-200 dark:border-white/10 hover:bg-gray-100 dark:hover:bg-white/10 hover:text-gray-900 dark:hover:text-zinc-100",
              ]}
            >
              {group.year}
            </button>
          );
        })}
      </div>

      <!-- Year Panels -->
      {siteConfig.awards.map((group, idx) => {
        const isDefault = idx === 0;
        return (
          <div
            data-award-year-panel={group.year}
            class:list={[
              "award-year-panel transition-opacity duration-200",
              isDefault ? "block opacity-100" : "hidden opacity-0",
            ]}
          >
            {group.items.length > 0 ? (
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
                {group.items.map((award) => (
                  <article class="flex flex-col bg-white dark:bg-zinc-800 rounded-xl border border-gray-200 dark:border-white/10 overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-200">
                    <!-- Top Neutral Placeholder Image Area -->
                    <div class="h-36 w-full bg-gray-100 dark:bg-zinc-900/60 border-b border-gray-200 dark:border-white/10 flex flex-col items-center justify-center gap-1.5 text-gray-400 dark:text-zinc-500">
                      <!-- Tabler photo icon -->
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M15 8h.01" />
                        <path d="M3 6a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-12z" />
                        <path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l5 5" />
                        <path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l3 3" />
                      </svg>
                    </div>

                    <!-- Card Body -->
                    <div class="p-4 sm:p-5 flex-1 flex flex-col justify-between gap-3">
                      <p class="text-sm text-gray-800 dark:text-zinc-100 leading-relaxed">
                        {award.text}
                      </p>

                      {award.credentialUrl && award.credentialUrl.trim() !== "" && (
                        <div class="pt-2.5 border-t border-gray-100 dark:border-white/10">
                          <a
                            href={award.credentialUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1.5 min-h-[40px] text-xs font-semibold text-[#0F766E] dark:text-teal-400 hover:underline"
                          >
                            <span>View credential</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                              <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" />
                              <path d="M11 13l9 -9" />
                              <path d="M15 4h5v5" />
                            </svg>
                          </a>
                        </div>
                      )}
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <div class="rounded-xl border border-dashed border-gray-200 dark:border-white/10 bg-white dark:bg-zinc-800 p-8 text-center">
                <p class="text-sm text-gray-500 dark:text-zinc-400">
                  No awards listed for {group.year} yet.
                </p>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </section>
)}

<script>
  const yearBtns = document.querySelectorAll<HTMLButtonElement>(".award-year-btn");
  const yearPanels = document.querySelectorAll<HTMLElement>(".award-year-panel");

  const ACTIVE_BTN = [
    "bg-[#0F766E]",
    "dark:bg-teal-500",
    "text-white",
    "border-[#0F766E]",
    "dark:border-teal-500",
    "shadow-sm",
  ];
  const INACTIVE_BTN = [
    "bg-white",
    "dark:bg-zinc-800",
    "text-gray-700",
    "dark:text-zinc-400",
    "border-gray-200",
    "dark:border-white/10",
    "hover:bg-gray-100",
    "dark:hover:bg-white/10",
    "hover:text-gray-900",
    "dark:hover:text-zinc-100",
  ];

  yearBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const selectedYear = btn.dataset.awardYearBtn;
      if (!selectedYear) return;

      yearBtns.forEach((b) => {
        const isActive = b.dataset.awardYearBtn === selectedYear;
        b.setAttribute("aria-pressed", isActive ? "true" : "false");
        if (isActive) {
          b.classList.remove(...INACTIVE_BTN);
          b.classList.add(...ACTIVE_BTN);
        } else {
          b.classList.remove(...ACTIVE_BTN);
          b.classList.add(...INACTIVE_BTN);
        }
      });

      yearPanels.forEach((panel) => {
        const isMatch = panel.dataset.awardYearPanel === selectedYear;
        if (isMatch) {
          panel.classList.remove("hidden");
          requestAnimationFrame(() => {
            panel.classList.remove("opacity-0");
            panel.classList.add("opacity-100");
          });
        } else {
          panel.classList.remove("opacity-100");
          panel.classList.add("opacity-0", "hidden");
        }
      });
    });
  });
</script>
