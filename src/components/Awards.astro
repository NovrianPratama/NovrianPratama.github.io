---
import { siteConfig } from "../config";
const hasAwards = siteConfig.awards && siteConfig.awards.length > 0;
---

{hasAwards && (
  <section id="awards" class="px-5 py-12 sm:px-8 sm:py-16 md:px-12 md:py-20 bg-gray-50 dark:bg-gray-900/60 transition-colors duration-200">
    <div class="max-w-6xl mx-auto">
      <!-- Header Row with Scroll Arrows -->
      <div class="flex items-end justify-between gap-4 mb-6 sm:mb-8">
        <div>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100">
            Awards
          </h2>
          <div
            class="w-14 h-1.5 mt-2.5 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          ></div>
        </div>

        <div class="flex items-center gap-2">
          <button
            id="awards-scroll-prev"
            type="button"
            aria-label="Previous awards"
            class="w-11 h-11 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 flex items-center justify-center text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors cursor-pointer"
          >
            <!-- Tabler chevron-left -->
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M15 6l-6 6l6 6" />
            </svg>
          </button>
          <button
            id="awards-scroll-next"
            type="button"
            aria-label="Next awards"
            class="w-11 h-11 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 flex items-center justify-center text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors cursor-pointer"
          >
            <!-- Tabler chevron-right -->
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M9 6l6 6l-6 6" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Horizontal Scroll Track Grouped by Year -->
      <div
        id="awards-scroll-track"
        class="flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-3"
      >
        {siteConfig.awards.map((group) =>
          group.items.length > 0 ? (
            group.items.map((awardText) => (
              <article class="snap-start flex-shrink-0 w-72 sm:w-80 bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 p-4 sm:p-5 shadow-sm flex flex-col justify-between gap-3">
                <div class="flex items-start gap-3.5">
                  <!-- Small Award Icon Tile -->
                  <div
                    class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 bg-teal-50 dark:bg-teal-950/80 text-teal-700 dark:text-teal-400 border border-teal-200 dark:border-teal-800"
                  >
                    <!-- Tabler trophy / award icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                      <path d="M8 21l8 0" />
                      <path d="M12 17l0 4" />
                      <path d="M7 4l10 0" />
                      <path d="M17 4v8a5 5 0 0 1 -10 0v-8" />
                      <path d="M5 9m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                      <path d="M19 9m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                    </svg>
                  </div>

                  <div class="min-w-0 flex-1">
                    <span class="inline-block px-2 py-0.5 rounded text-xs font-mono font-semibold bg-teal-50 text-teal-800 dark:bg-teal-950/80 dark:text-teal-300 border border-teal-200 dark:border-teal-800 mb-1.5">
                      {group.year}
                    </span>
                    <p class="text-sm text-gray-800 dark:text-gray-200 leading-relaxed">
                      {awardText}
                    </p>
                  </div>
                </div>
              </article>
            ))
          ) : (
            <article class="snap-start flex-shrink-0 w-56 bg-white/60 dark:bg-gray-900/60 rounded-xl border border-dashed border-gray-200 dark:border-gray-800 p-4 sm:p-5 flex flex-col justify-center">
              <span class="inline-block self-start px-2 py-0.5 rounded text-xs font-mono font-semibold bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400 mb-1.5">
                {group.year}
              </span>
              <p class="text-xs text-gray-400 dark:text-gray-500">
                No entries listed under {group.year}.
              </p>
            </article>
          )
        )}
      </div>
    </div>
  </section>
)}

<script>
  const awardsTrack = document.getElementById("awards-scroll-track");
  const awardsPrev = document.getElementById("awards-scroll-prev");
  const awardsNext = document.getElementById("awards-scroll-next");

  awardsPrev?.addEventListener("click", () => {
    awardsTrack?.scrollBy({ left: -320, behavior: "smooth" });
  });

  awardsNext?.addEventListener("click", () => {
    awardsTrack?.scrollBy({ left: 320, behavior: "smooth" });
  });
</script>
