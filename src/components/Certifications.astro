---
import { siteConfig } from "../config";
const hasCertifications = siteConfig.certifications && siteConfig.certifications.length > 0;
---

{hasCertifications && (
  <section id="certifications" class="px-5 py-12 sm:px-8 sm:py-16 md:px-12 md:py-20 bg-gray-50 dark:bg-gray-900/60 transition-colors duration-200">
    <div class="max-w-6xl mx-auto">
      <!-- Header Row with Scroll Arrows -->
      <div class="flex items-end justify-between gap-4 mb-6 sm:mb-8">
        <div>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100">
            Certifications
          </h2>
          <div
            class="w-14 h-1.5 mt-2.5 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          ></div>
        </div>

        <div class="flex items-center gap-2">
          <button
            id="cert-scroll-prev"
            type="button"
            aria-label="Previous certifications"
            class="w-11 h-11 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 flex items-center justify-center text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors cursor-pointer"
          >
            <!-- Tabler chevron-left -->
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M15 6l-6 6l6 6" />
            </svg>
          </button>
          <button
            id="cert-scroll-next"
            type="button"
            aria-label="Next certifications"
            class="w-11 h-11 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 flex items-center justify-center text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors cursor-pointer"
          >
            <!-- Tabler chevron-right -->
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M9 6l6 6l-6 6" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Horizontal Scroll Track -->
      <div
        id="cert-scroll-track"
        class="flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-3"
      >
        {siteConfig.certifications.map((cert) => (
          <article class="snap-start flex-shrink-0 w-72 sm:w-80 bg-white dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 p-4 sm:p-5 shadow-sm flex flex-col justify-between gap-3">
            <div class="flex items-start gap-3.5">
              <!-- Small Certificate Icon Tile -->
              <div
                class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 bg-teal-50 dark:bg-teal-950/80 text-teal-700 dark:text-teal-400 border border-teal-200 dark:border-teal-800"
              >
                <!-- Tabler certificate icon -->
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                  <path d="M15 15m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                  <path d="M13 17.5v4.5l2 -1.5l2 1.5v-4.5" />
                  <path d="M10 19h-5a2 2 0 0 1 -2 -2v-10c0 -1.1 .9 -2 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -1 1.73" />
                  <path d="M6 9l12 0" />
                  <path d="M6 12l3 0" />
                  <path d="M6 15l2 0" />
                </svg>
              </div>

              <div class="min-w-0 flex-1">
                <h3 class="text-sm sm:text-base font-semibold text-gray-900 dark:text-gray-100 leading-snug">
                  {cert.name}
                </h3>
                <p class="text-xs sm:text-sm text-teal-700 dark:text-teal-400 font-medium mt-1">
                  {cert.issuer}
                </p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">
                  {cert.year}
                </p>
              </div>
            </div>

            {cert.credentialUrl && cert.credentialUrl.trim() !== "" && (
              <div class="pt-2.5 border-t border-gray-100 dark:border-gray-800">
                <a
                  href={cert.credentialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 min-h-[44px] text-xs font-semibold text-teal-700 dark:text-teal-400 hover:underline"
                >
                  <span>Show credential</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" />
                    <path d="M11 13l9 -9" />
                    <path d="M15 4h5v5" />
                  </svg>
                </a>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<script>
  const certTrack = document.getElementById("cert-scroll-track");
  const certPrev = document.getElementById("cert-scroll-prev");
  const certNext = document.getElementById("cert-scroll-next");

  certPrev?.addEventListener("click", () => {
    certTrack?.scrollBy({ left: -320, behavior: "smooth" });
  });

  certNext?.addEventListener("click", () => {
    certTrack?.scrollBy({ left: 320, behavior: "smooth" });
  });
</script>
