---
import { siteConfig } from "../config";
const hasCertifications = siteConfig.certifications && siteConfig.certifications.length > 0;
const categories = ["All", "Technology", "Language", "Other"];
---

{hasCertifications && (
  <section id="certifications" class="px-5 py-12 sm:px-8 sm:py-16 md:px-12 md:py-20 bg-gray-50 dark:bg-zinc-900 transition-colors duration-200">
    <div class="max-w-6xl mx-auto">
      <!-- Section Header -->
      <div class="mb-6">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-zinc-100">
          Certifications
        </h2>
        <div class="w-14 h-1.5 mt-2.5 rounded-full bg-[#0F766E] dark:bg-teal-400"></div>
      </div>

      <!-- Category Filter Buttons (All, Technology, Language, Other) -->
      <div class="flex flex-wrap items-center gap-2 mb-8" role="group" aria-label="Filter certifications by category">
        {categories.map((cat, idx) => {
          const isDefault = idx === 0;
          return (
            <button
              type="button"
              data-cert-cat-btn={cat}
              aria-pressed={isDefault ? "true" : "false"}
              class:list={[
                "cert-cat-btn px-4 py-2 rounded-full text-xs sm:text-sm font-semibold border transition-all duration-200 cursor-pointer",
                isDefault
                  ? "bg-[#0F766E] dark:bg-teal-500 text-white border-[#0F766E] dark:border-teal-500 shadow-sm"
                  : "bg-white dark:bg-zinc-800 text-gray-700 dark:text-zinc-400 border-gray-200 dark:border-white/10 hover:bg-gray-100 dark:hover:bg-white/10 hover:text-gray-900 dark:hover:text-zinc-100",
              ]}
            >
              {cat}
            </button>
          );
        })}
      </div>

      <!-- Responsive 3-Column Grid -->
      <div
        id="cert-grid"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 transition-opacity duration-200"
      >
        {siteConfig.certifications.map((cert) => (
          <article
            data-cert-category={cert.category}
            class="cert-card bg-white dark:bg-zinc-800 rounded-xl border border-gray-200 dark:border-white/10 p-4 sm:p-5 shadow-sm hover:shadow-md transition-shadow duration-200 flex flex-col justify-between gap-3"
          >
            <div class="flex items-start gap-3.5">
              <!-- Small Certificate Icon Tile -->
              <div
                class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 bg-teal-50 dark:bg-teal-500/15 text-[#0F766E] dark:text-teal-400 border border-teal-200 dark:border-teal-400/25"
              >
                <!-- Tabler certificate icon -->
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                  <path d="M15 15m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                  <path d="M13 17.5v4.5l2 -1.5l2 1.5v-4.5" />
                  <path d="M10 19h-5a2 2 0 0 1 -2 -2v-10c0 -1.1 .9 -2 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -1 1.73" />
                  <path d="M6 9l12 0" />
                  <path d="M6 12l3 0" />
                  <path d="M6 15l2 0" />
                </svg>
              </div>

              <div class="min-w-0 flex-1">
                <h3 class="text-sm sm:text-base font-semibold text-gray-900 dark:text-zinc-100 leading-snug">
                  {cert.name}
                </h3>
                <p class="text-xs sm:text-sm text-[#0F766E] dark:text-teal-400 font-medium mt-1">
                  {cert.issuer}
                </p>
                <p class="text-xs text-gray-500 dark:text-zinc-400 mt-0.5">
                  {cert.year}
                </p>
              </div>
            </div>

            {cert.credentialUrl && cert.credentialUrl.trim() !== "" && (
              <div class="pt-2.5 border-t border-gray-100 dark:border-white/10">
                <a
                  href={cert.credentialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 min-h-[40px] text-xs font-semibold text-[#0F766E] dark:text-teal-400 hover:underline"
                >
                  <span>Show credential</span>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" />
                    <path d="M11 13l9 -9" />
                    <path d="M15 4h5v5" />
                  </svg>
                </a>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<script>
  const catBtns = document.querySelectorAll<HTMLButtonElement>(".cert-cat-btn");
  const certCards = document.querySelectorAll<HTMLElement>(".cert-card");
  const certGrid = document.getElementById("cert-grid");

  const ACTIVE_BTN = [
    "bg-[#0F766E]",
    "dark:bg-teal-500",
    "text-white",
    "border-[#0F766E]",
    "dark:border-teal-500",
    "shadow-sm",
  ];
  const INACTIVE_BTN = [
    "bg-white",
    "dark:bg-zinc-800",
    "text-gray-700",
    "dark:text-zinc-400",
    "border-gray-200",
    "dark:border-white/10",
    "hover:bg-gray-100",
    "dark:hover:bg-white/10",
    "hover:text-gray-900",
    "dark:hover:text-zinc-100",
  ];

  catBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const selectedCat = btn.dataset.certCatBtn;
      if (!selectedCat) return;

      catBtns.forEach((b) => {
        const isActive = b.dataset.certCatBtn === selectedCat;
        b.setAttribute("aria-pressed", isActive ? "true" : "false");
        if (isActive) {
          b.classList.remove(...INACTIVE_BTN);
          b.classList.add(...ACTIVE_BTN);
        } else {
          b.classList.remove(...ACTIVE_BTN);
          b.classList.add(...INACTIVE_BTN);
        }
      });

      if (certGrid) {
        certGrid.classList.add("opacity-0");
      }

      setTimeout(() => {
        certCards.forEach((card) => {
          const cardCat = card.dataset.certCategory;
          if (selectedCat === "All" || cardCat === selectedCat) {
            card.classList.remove("hidden");
          } else {
            card.classList.add("hidden");
          }
        });
        if (certGrid) {
          certGrid.classList.remove("opacity-0");
        }
      }, 120);
    });
  });
</script>
