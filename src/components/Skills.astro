---
import { siteConfig } from "../config";
import { skillIcons } from "../icons/skillIcons";
const hasSkills = siteConfig.skillGroups && siteConfig.skillGroups.length > 0;
---

{hasSkills && (
  <section id="skills" class="px-5 py-12 sm:px-8 sm:py-16 md:px-12 md:py-20 bg-gray-50 dark:bg-zinc-900 transition-colors duration-200">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">

        <!-- Label -->
        <div class="lg:col-span-4 reveal-item">
          <h2
            data-i18n="skills.heading"
            class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-zinc-100"
          >
            Skills
          </h2>
          <div class="w-14 h-1.5 mt-2.5 rounded-full bg-[#0F766E] dark:bg-teal-400"></div>
          <p
            data-i18n="skills.intro"
            class="mt-3 text-sm text-gray-500 dark:text-zinc-400 leading-relaxed"
          >
            Tools and technologies I have experience using across data analytics and business intelligence projects.
          </p>
        </div>

        <!-- Skill groups -->
        <div class="lg:col-span-8 space-y-6">
          {siteConfig.skillGroups.map((group, gIdx) => (
            <div
              style={`--reveal-delay: ${Math.min(gIdx * 80, 240)}ms;`}
              class="reveal-item"
            >
              <h3
                data-i18n={`skills.group.${gIdx}`}
                class="text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-zinc-500 mb-3"
              >
                {group.label}
              </h3>
              <div class="flex flex-wrap gap-2.5">
                {group.tools.map((tool) => {
                  const iconPath = skillIcons[tool];
                  return (
                    <span
                      class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg text-sm font-medium bg-white dark:bg-zinc-800 border border-gray-200 dark:border-white/10 text-gray-800 dark:text-zinc-100 shadow-sm hover:border-gray-300 dark:hover:bg-white/10 transition-colors duration-150"
                    >
                      {iconPath ? (
                        <svg
                          class="w-4 h-4 text-teal-700 dark:text-teal-400 flex-shrink-0"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <path d={iconPath} />
                        </svg>
                      ) : (
                        <svg
                          class="w-4 h-4 text-teal-700 dark:text-teal-400 flex-shrink-0"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                        >
                          <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                          <path d="M7 8l-4 4l4 4" />
                          <path d="M17 8l4 4l-4 4" />
                          <path d="M14 4l-4 16" />
                        </svg>
                      )}
                      <span>{tool}</span>
                    </span>
                  );
                })}
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>
)}
