---
import { siteConfig } from "../config";
const hasOrganizations = siteConfig.organizations && siteConfig.organizations.length > 0;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

{hasOrganizations && (
  <section id="organizations" class="px-5 py-12 sm:px-8 sm:py-16 md:px-12 md:py-20 bg-white dark:bg-zinc-900 transition-colors duration-200">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">

        <!-- Section Label -->
        <div class="lg:col-span-4">
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-zinc-100">
            Organizations
          </h2>
          <div class="w-14 h-1.5 mt-2.5 rounded-full bg-[#0F766E] dark:bg-teal-400"></div>
        </div>

        <!-- Organization Cards -->
        <div class="lg:col-span-8 space-y-6">
          {siteConfig.organizations.map((org) => {
            const hasPhotos = org.photos && org.photos.length > 0;
            const firstPhoto = hasPhotos ? `${baseUrl}/${org.photos[0].replace(/^\//, "")}` : null;
            return (
              <article class="bg-gray-50 dark:bg-zinc-800 rounded-xl border border-gray-200 dark:border-white/10 p-5 sm:p-6 shadow-sm">
                <!-- Activity Photo Area at Top of Card -->
                <div class="mb-5">
                  {hasPhotos && firstPhoto ? (
                    <div class="space-y-2.5" data-org-gallery>
                      <div class="aspect-video w-full rounded-lg overflow-hidden border border-gray-200 dark:border-white/10 bg-gray-100 dark:bg-zinc-900/60">
                        <img
                          data-org-featured-img
                          src={firstPhoto}
                          alt={`${org.name} activity`}
                          class="w-full h-full object-cover"
                          loading="lazy"
                        />
                      </div>
                      {org.photos.length > 1 && (
                        <div class="flex flex-wrap gap-2">
                          {org.photos.map((photoPath, pIdx) => {
                            const thumbSrc = `${baseUrl}/${photoPath.replace(/^\//, "")}`;
                            return (
                              <button
                                type="button"
                                data-org-thumb={thumbSrc}
                                aria-label={`View activity photo ${pIdx + 1} for ${org.name}`}
                                class="w-16 h-11 rounded-md overflow-hidden border border-gray-200 dark:border-white/10 opacity-80 hover:opacity-100 focus:opacity-100 transition-opacity cursor-pointer"
                              >
                                <img src={thumbSrc} alt="" class="w-full h-full object-cover" loading="lazy" />
                              </button>
                            );
                          })}
                        </div>
                      )}
                    </div>
                  ) : (
                    <div class="aspect-video w-full rounded-lg border border-dashed border-gray-200 dark:border-white/10 bg-gray-100/80 dark:bg-zinc-900/50 flex flex-col items-center justify-center gap-2 text-gray-400 dark:text-zinc-500">
                      <!-- Tabler photo icon -->
                      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M15 8h.01" />
                        <path d="M3 6a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-12z" />
                        <path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l5 5" />
                        <path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l3 3" />
                      </svg>
                    </div>
                  )}
                </div>

                <!-- Organization Header: Monogram + Role, Name, Period, Location -->
                <div class="flex items-start gap-4 mb-3.5">
                  <!-- Neutral Monogram Tile -->
                  <div
                    class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 font-bold text-sm tracking-wider bg-teal-50 dark:bg-teal-500/15 text-teal-800 dark:text-teal-400 border border-teal-200 dark:border-teal-400/25"
                    aria-hidden="true"
                  >
                    {org.initials}
                  </div>

                  <div class="flex-1 min-w-0">
                    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1">
                      <div>
                        <h3 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-zinc-100 leading-snug">
                          {org.role}
                        </h3>
                        <p class="text-sm sm:text-base font-medium text-[#0F766E] dark:text-teal-400 mt-0.5">
                          {org.name}
                        </p>
                      </div>
                      <div class="sm:text-right flex-shrink-0">
                        <p class="text-xs sm:text-sm text-gray-500 dark:text-zinc-400 whitespace-nowrap">
                          {org.period}
                        </p>
                        <p class="text-xs text-gray-400 dark:text-zinc-500">
                          {org.location}
                        </p>
                      </div>
                    </div>
                  </div>
                </div>

                <ul class="space-y-2 pl-1">
                  {org.bullets.map((bullet) => (
                    <li class="flex items-start gap-2.5">
                      <span class="inline-block w-1.5 h-1.5 rounded-full mt-2 flex-shrink-0 bg-[#0F766E] dark:bg-teal-400"></span>
                      <span class="text-sm text-gray-600 dark:text-zinc-400 leading-relaxed">{bullet}</span>
                    </li>
                  ))}
                </ul>
              </article>
            );
          })}
        </div>

      </div>
    </div>
  </section>
)}

<script>
  const galleries = document.querySelectorAll("[data-org-gallery]");
  galleries.forEach((gallery) => {
    const featuredImg = gallery.querySelector<HTMLImageElement>("[data-org-featured-img]");
    const thumbs = gallery.querySelectorAll<HTMLButtonElement>("[data-org-thumb]");
    thumbs.forEach((thumb) => {
      thumb.addEventListener("click", () => {
        const newSrc = thumb.dataset.orgThumb;
        if (featuredImg && newSrc) {
          featuredImg.src = newSrc;
        }
      });
    });
  });
</script>
