---
import { siteConfig } from "../config";
const hasOrganizations = siteConfig.organizations && siteConfig.organizations.length > 0;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

{hasOrganizations && (
  <section id="organizations" class="px-5 py-12 sm:px-8 sm:py-16 md:px-12 md:py-20 bg-white dark:bg-zinc-900 transition-colors duration-200">
    <div class="max-w-6xl mx-auto">
      <!-- Top Section Header -->
      <div class="mb-8">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-zinc-100">
          Organizations
        </h2>
        <div class="w-14 h-1.5 mt-2.5 rounded-full bg-[#0F766E] dark:bg-teal-400"></div>
      </div>

      <!-- Compact 3-Column Grid (same size and rhythm as project cards) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {siteConfig.organizations.map((org, idx) => {
          const modalId = `org-modal-${idx}`;
          const hasPhotos = org.photos && org.photos.length > 0;
          const coverPhoto = hasPhotos ? `${baseUrl}/${org.photos[0].replace(/^\//, "")}` : null;
          const summaryText = org.bullets && org.bullets.length > 0 ? org.bullets[0] : "";

          return (
            <article class="flex flex-col bg-gray-50 dark:bg-zinc-800 rounded-xl border border-gray-200 dark:border-white/10 overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-200">
              <!-- Compact Top Image Area with Click Affordance -->
              <button
                type="button"
                data-org-modal-open={modalId}
                aria-label={`Open details and activity photos for ${org.name}`}
                class="group relative h-36 w-full bg-gray-100 dark:bg-zinc-900/60 border-b border-gray-200 dark:border-white/10 overflow-hidden text-left cursor-pointer focus:outline-none"
              >
                {coverPhoto ? (
                  <img
                    src={coverPhoto}
                    alt={`${org.name} activity`}
                    class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-200"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex flex-col items-center justify-center gap-1.5 text-gray-400 dark:text-zinc-500">
                    <!-- Tabler photo icon -->
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M15 8h.01" />
                      <path d="M3 6a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-12z" />
                      <path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l5 5" />
                      <path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l3 3" />
                    </svg>
                  </div>
                )}

                <!-- Monogram Badge in Top-Left Corner -->
                <span
                  class="absolute top-2.5 left-2.5 inline-flex items-center justify-center w-8 h-8 rounded-lg font-bold text-xs tracking-wider bg-teal-50/95 dark:bg-zinc-800/90 text-[#0F766E] dark:text-teal-400 border border-teal-200 dark:border-white/15 shadow-sm"
                  aria-hidden="true"
                >
                  {org.initials}
                </span>

                <!-- Expand/Maximize Tabler Icon Overlay in Top-Right Corner -->
                <span
                  class="absolute top-2.5 right-2.5 inline-flex items-center justify-center w-8 h-8 rounded-lg bg-white/90 dark:bg-zinc-800/90 text-gray-700 dark:text-zinc-100 border border-gray-200 dark:border-white/15 shadow-sm group-hover:bg-[#0F766E] dark:group-hover:bg-teal-500 group-hover:text-white group-hover:border-transparent transition-colors duration-150"
                  aria-hidden="true"
                >
                  <!-- Tabler arrows-maximize icon -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M16 4l4 0l0 4" />
                    <path d="M14 10l6 -6" />
                    <path d="M8 20l-4 0l0 -4" />
                    <path d="M4 20l6 -6" />
                    <path d="M16 20l4 0l0 -4" />
                    <path d="M14 14l6 6" />
                    <path d="M8 4l-4 0l0 4" />
                    <path d="M4 4l6 6" />
                  </svg>
                </span>
              </button>

              <!-- Compact Card Body -->
              <div class="p-4 flex-1 flex flex-col justify-between space-y-3.5">
                <div class="space-y-1.5">
                  <h3 class="text-base font-bold text-gray-900 dark:text-zinc-100 leading-snug line-clamp-2">
                    {org.name}
                  </h3>
                  <p class="text-xs sm:text-sm font-semibold text-[#0F766E] dark:text-teal-400">
                    {org.role}
                  </p>
                  <p class="text-xs text-gray-500 dark:text-zinc-400">
                    {org.period} &middot; {org.location}
                  </p>
                  {summaryText && (
                    <p class="pt-1 text-xs sm:text-sm text-gray-600 dark:text-zinc-400 leading-relaxed line-clamp-2">
                      {summaryText}
                    </p>
                  )}
                </div>

                <!-- View Details Button -->
                <div class="pt-2.5 border-t border-gray-200/80 dark:border-white/10 flex items-center justify-between">
                  <button
                    type="button"
                    data-org-modal-open={modalId}
                    class="inline-flex items-center gap-1.5 min-h-[40px] text-xs sm:text-sm font-semibold text-[#0F766E] dark:text-teal-400 hover:underline cursor-pointer"
                  >
                    <span>View details</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12h14"></path>
                      <path d="m12 5 7 7-7 7"></path>
                    </svg>
                  </button>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Popup Modals for Each Organization -->
      {siteConfig.organizations.map((org, idx) => {
        const modalId = `org-modal-${idx}`;
        const titleId = `org-modal-title-${idx}`;
        const hasPhotos = org.photos && org.photos.length > 0;

        return (
          <div
            id={modalId}
            role="dialog"
            aria-modal="true"
            aria-labelledby={titleId}
            aria-label={org.name}
            class="org-modal fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6"
          >
            <!-- Dimmed, Blurred Backdrop -->
            <div
              data-org-modal-backdrop
              class="fixed inset-0 bg-black/60 backdrop-blur-sm transition-opacity"
            ></div>

            <!-- Modal Panel -->
            <div class="relative z-10 w-full max-w-2xl max-h-[85vh] overflow-y-auto rounded-2xl bg-white dark:bg-zinc-800 border border-gray-200 dark:border-white/10 p-5 sm:p-7 shadow-2xl text-gray-900 dark:text-zinc-100">
              <!-- Modal Header -->
              <div class="flex items-start justify-between gap-4 pb-4 border-b border-gray-200 dark:border-white/10">
                <div class="flex items-start gap-3.5 min-w-0">
                  <div
                    class="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0 font-bold text-sm tracking-wider bg-teal-50 dark:bg-teal-500/15 text-[#0F766E] dark:text-teal-400 border border-teal-200 dark:border-teal-400/25"
                    aria-hidden="true"
                  >
                    {org.initials}
                  </div>
                  <div class="min-w-0">
                    <h3 id={titleId} class="text-lg sm:text-xl font-bold text-gray-900 dark:text-zinc-100 leading-snug">
                      {org.name}
                    </h3>
                    <p class="text-sm font-semibold text-[#0F766E] dark:text-teal-400 mt-0.5">
                      {org.role}
                    </p>
                    <p class="text-xs text-gray-500 dark:text-zinc-400 mt-0.5">
                      {org.period} &middot; {org.location}
                    </p>
                  </div>
                </div>

                <!-- Close (X) Button -->
                <button
                  type="button"
                  data-org-modal-close
                  aria-label="Close modal"
                  class="w-10 h-10 min-w-[40px] min-h-[40px] inline-flex items-center justify-center rounded-full bg-gray-100 dark:bg-zinc-900/70 text-gray-600 dark:text-zinc-400 hover:bg-gray-200 dark:hover:bg-white/10 hover:text-gray-900 dark:hover:text-zinc-100 transition-colors cursor-pointer flex-shrink-0"
                >
                  <!-- Tabler x icon -->
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M18 6l-12 12" />
                    <path d="M6 6l12 12" />
                  </svg>
                </button>
              </div>

              <!-- Modal Body: Full Bullet Points -->
              <div class="py-5 space-y-3">
                <h4 class="text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-zinc-500">
                  Key Contributions
                </h4>
                <ul class="space-y-2.5">
                  {org.bullets.map((bullet) => (
                    <li class="flex items-start gap-2.5">
                      <span class="inline-block w-1.5 h-1.5 rounded-full mt-2 flex-shrink-0 bg-[#0F766E] dark:bg-teal-400"></span>
                      <span class="text-sm text-gray-700 dark:text-zinc-100/90 leading-relaxed">{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Modal Footer: Activity Documentation Photo Gallery -->
              <div class="pt-4 border-t border-gray-200 dark:border-white/10 space-y-3">
                <h4 class="text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-zinc-500">
                  Activity Documentation
                </h4>
                {hasPhotos ? (
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    {org.photos.map((photoPath, pIdx) => {
                      const imgSrc = `${baseUrl}/${photoPath.replace(/^\//, "")}`;
                      return (
                        <div class="aspect-video w-full rounded-xl overflow-hidden border border-gray-200 dark:border-white/10 bg-gray-100 dark:bg-zinc-900/60">
                          <img
                            src={imgSrc}
                            alt={`${org.name} activity photo ${pIdx + 1}`}
                            class="w-full h-full object-cover"
                            loading="lazy"
                          />
                        </div>
                      );
                    })}
                  </div>
                ) : (
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="aspect-video w-full rounded-xl border border-dashed border-gray-200 dark:border-white/10 bg-gray-100/80 dark:bg-zinc-900/50 flex flex-col items-center justify-center gap-1.5 text-gray-400 dark:text-zinc-500">
                      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M15 8h.01" />
                        <path d="M3 6a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-12z" />
                        <path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l5 5" />
                        <path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l3 3" />
                      </svg>
                    </div>
                    <div class="aspect-video w-full rounded-xl border border-dashed border-gray-200 dark:border-white/10 bg-gray-100/80 dark:bg-zinc-900/50 flex flex-col items-center justify-center gap-1.5 text-gray-400 dark:text-zinc-500">
                      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M15 8h.01" />
                        <path d="M3 6a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-12z" />
                        <path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l5 5" />
                        <path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l3 3" />
                      </svg>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>
)}

<script>
  let activeModal: HTMLElement | null = null;
  let lastTrigger: HTMLElement | null = null;

  function openOrgModal(modalId: string, trigger: HTMLElement) {
    const modal = document.getElementById(modalId);
    if (!modal) return;
    lastTrigger = trigger;
    activeModal = modal;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.classList.add("overflow-hidden");

    const closeBtn = modal.querySelector<HTMLButtonElement>("[data-org-modal-close]");
    closeBtn?.focus();
  }

  function closeOrgModal() {
    if (!activeModal) return;
    activeModal.classList.remove("flex");
    activeModal.classList.add("hidden");
    document.body.classList.remove("overflow-hidden");
    const triggerToFocus = lastTrigger;
    activeModal = null;
    lastTrigger = null;
    triggerToFocus?.focus();
  }

  document.querySelectorAll<HTMLElement>("[data-org-modal-open]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetId = btn.dataset.orgModalOpen;
      if (targetId) {
        openOrgModal(targetId, btn);
      }
    });
  });

  document.querySelectorAll<HTMLElement>(".org-modal").forEach((modal) => {
    const closeBtn = modal.querySelector<HTMLElement>("[data-org-modal-close]");
    const backdrop = modal.querySelector<HTMLElement>("[data-org-modal-backdrop]");

    closeBtn?.addEventListener("click", () => {
      closeOrgModal();
    });

    backdrop?.addEventListener("click", () => {
      closeOrgModal();
    });
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && activeModal) {
      closeOrgModal();
    }
  });
</script>
