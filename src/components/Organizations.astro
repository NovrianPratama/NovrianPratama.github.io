---
import { siteConfig } from "../config";
const hasOrganizations = siteConfig.organizations && siteConfig.organizations.length > 0;
---

{hasOrganizations && (
  <section id="organizations" class="px-5 py-12 sm:px-8 sm:py-16 md:px-12 md:py-20 bg-white dark:bg-gray-950 transition-colors duration-200">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">

        <!-- Section Label -->
        <div class="lg:col-span-4">
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100">
            Organizations
          </h2>
          <div
            class="w-14 h-1.5 mt-2.5 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          ></div>
        </div>

        <!-- Organization Cards -->
        <div class="lg:col-span-8 space-y-5">
          {siteConfig.organizations.map((org) => (
            <article class="bg-gray-50 dark:bg-gray-900 rounded-xl border border-gray-200 dark:border-gray-800 p-5 sm:p-6 shadow-sm">
              <div class="flex items-start gap-4 mb-3.5">
                <!-- Neutral Monogram Tile -->
                <div
                  class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 font-bold text-sm tracking-wider bg-teal-50 dark:bg-teal-950/80 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800"
                  aria-hidden="true"
                >
                  {org.initials}
                </div>

                <div class="flex-1 min-w-0">
                  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-1">
                    <div>
                      <h3 class="text-base sm:text-lg font-semibold text-gray-900 dark:text-gray-100 leading-snug">
                        {org.role}
                      </h3>
                      <p class="text-sm sm:text-base font-medium text-teal-700 dark:text-teal-400 mt-0.5">
                        {org.name}
                      </p>
                    </div>
                    <div class="sm:text-right flex-shrink-0">
                      <p class="text-xs sm:text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">
                        {org.period}
                      </p>
                      <p class="text-xs text-gray-400 dark:text-gray-500">
                        {org.location}
                      </p>
                    </div>
                  </div>
                </div>
              </div>

              <ul class="space-y-2 pl-1">
                {org.bullets.map((bullet) => (
                  <li class="flex items-start gap-2.5">
                    <span
                      class="inline-block w-1.5 h-1.5 rounded-full mt-2 flex-shrink-0"
                      style={`background-color: ${siteConfig.accentColor}`}
                    ></span>
                    <span class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">{bullet}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>

      </div>
    </div>
  </section>
)}
