---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{hasProjects && (
  <section id="projects" class="px-8 py-16 sm:px-12 sm:py-20 md:px-24 md:py-24">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">

        <!-- Label -->
        <div class="lg:col-span-4">
          <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold text-gray-900">
            Projects
          </h2>
          <div
            class="w-16 h-1.5 mt-3 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          ></div>
        </div>

        <!-- Project cards -->
        <div class="lg:col-span-8">
          <div class="space-y-6">
            {siteConfig.projects.map((project, index) => {
              const caseStudyHref = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/projects/${project.slug}`;
              const isInProgress = project.status === "in-progress";

              return (
                <a
                  href={caseStudyHref}
                  class="group block relative p-5 sm:p-6 md:p-8 bg-gray-50 rounded-2xl border border-gray-200 transition-all duration-300 hover:bg-white hover:shadow-lg hover:border-gray-300 hover:-translate-y-0.5"
                >
                  <!-- Arrow icon -->
                  <div class="absolute top-5 right-5 sm:top-6 sm:right-6 w-9 h-9 flex items-center justify-center bg-gray-900 rounded-full text-white transition-all duration-300 group-hover:bg-gray-700">
                    <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17"></path>
                    </svg>
                  </div>

                  <div class="space-y-3 pr-12">
                    <!-- Number + badge -->
                    <div class="flex items-center gap-3">
                      <span class="text-sm font-mono" style={`color: ${siteConfig.accentColor}`}>
                        0{index + 1}
                      </span>
                      {isInProgress && (
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200">
                          IN PROGRESS
                        </span>
                      )}
                    </div>

                    <!-- Name -->
                    <h3 class="text-lg sm:text-xl font-bold text-gray-900 leading-snug">
                      {project.name}
                    </h3>

                    <!-- Description -->
                    <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
                      {project.description}
                    </p>

                    <!-- Tools -->
                    {project.tools && project.tools.length > 0 && (
                      <div class="flex flex-wrap gap-2 pt-1">
                        {project.tools.map((tool) => (
                          <span class="px-2.5 py-1 bg-gray-900 text-white rounded-md text-xs font-medium transition-colors duration-200 group-hover:bg-gray-800">
                            {tool}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
        </div>

      </div>
    </div>
  </section>
)}
