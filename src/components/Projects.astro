---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

{hasProjects && (
  <section id="projects" class="px-5 py-12 sm:px-8 sm:py-16 md:px-12 md:py-20 bg-white dark:bg-gray-950 transition-colors duration-200">
    <div class="max-w-6xl mx-auto">
      <!-- Top Header Row -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 sm:mb-10">
        <div>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-gray-100">
            Projects
          </h2>
          <div
            class="w-14 h-1.5 mt-2.5 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          ></div>
        </div>

        <a
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 min-h-[44px] px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 text-sm font-semibold text-gray-800 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors self-start sm:self-auto"
        >
          <!-- GitHub icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"></path>
          </svg>
          <span>Explore All Repos</span>
          <!-- External link icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" />
            <path d="M11 13l9 -9" />
            <path d="M15 4h5v5" />
          </svg>
        </a>
      </div>

      <!-- 4-Card Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        {siteConfig.projects.map((project, index) => {
          const isComingSoon = project.status === "coming-soon" || !project.slug;
          const isInProgress = project.status === "in-progress";
          const caseStudyHref = !isComingSoon ? `${baseUrl}/projects/${project.slug}` : null;
          const repoHref = (project as any).repoLink || null;
          const imgSrc = `${baseUrl}/${(project.image || "/project-placeholder.svg").replace(/^\//, "")}`;

          return (
            <article class="flex flex-col bg-gray-50 dark:bg-gray-900 rounded-2xl border border-gray-200 dark:border-gray-800 overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-200">
              <!-- Top Image Area -->
              <div class="relative aspect-video w-full bg-gray-100 dark:bg-gray-800 border-b border-gray-200 dark:border-gray-800 overflow-hidden">
                <img
                  src={imgSrc}
                  alt={`${project.name} preview`}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
                {isInProgress && (
                  <span class="absolute top-3 left-3 inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 dark:bg-amber-950/90 dark:text-amber-300 border border-amber-200 dark:border-amber-800">
                    In progress
                  </span>
                )}
                {isComingSoon && (
                  <span class="absolute top-3 left-3 inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-200 text-gray-700 dark:bg-gray-800 dark:text-gray-300 border border-gray-300 dark:border-gray-700">
                    Coming soon
                  </span>
                )}
              </div>

              <!-- Card Body -->
              <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between space-y-5">
                <div class="space-y-3">
                  <!-- Title + Number row -->
                  <div class="flex items-start justify-between gap-4">
                    <h3 class="text-lg sm:text-xl font-bold text-gray-900 dark:text-gray-100 leading-snug">
                      {project.name}
                    </h3>
                    <span class="text-xs sm:text-sm font-mono font-semibold text-teal-700 dark:text-teal-400 flex-shrink-0 mt-1">
                      0{index + 1}
                    </span>
                  </div>

                  <!-- Description -->
                  <p class="text-sm sm:text-base text-gray-600 dark:text-gray-300 leading-relaxed">
                    {project.description}
                  </p>
                </div>

                <div class="space-y-4 pt-2">
                  <!-- Tech Stack Chips -->
                  {project.tools && project.tools.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 sm:gap-2">
                      {project.tools.map((tool) => (
                        <span class="px-2.5 py-1 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-200 border border-gray-200 dark:border-gray-700 rounded-md text-xs font-medium">
                          {tool}
                        </span>
                      ))}
                    </div>
                  )}

                  <!-- Footer Links -->
                  {(caseStudyHref || repoHref) && (
                    <div class="pt-3 border-t border-gray-200/80 dark:border-gray-800 flex items-center justify-between gap-4">
                      {caseStudyHref ? (
                        <a
                          href={caseStudyHref}
                          class="inline-flex items-center gap-1.5 min-h-[44px] text-sm font-semibold text-teal-700 dark:text-teal-400 hover:underline"
                        >
                          <span>View Details</span>
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14"></path>
                            <path d="m12 5 7 7-7 7"></path>
                          </svg>
                        </a>
                      ) : <span />}

                      {repoHref && (
                        <a
                          href={repoHref}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 min-h-[44px] text-xs sm:text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                        >
                          <span>Repository</span>
                          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" />
                            <path d="M11 13l9 -9" />
                            <path d="M15 4h5v5" />
                          </svg>
                        </a>
                      )}
                    </div>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}
