---
import { siteConfig } from "../config";
---

<section id="about" class="px-8 py-16 sm:px-12 sm:py-20 md:px-24 md:py-24">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">

      <!-- Section label -->
      <div class="lg:col-span-4">
        <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold text-gray-900">
          About Me
        </h2>
        <div
          class="w-16 h-1.5 mt-3 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        ></div>
      </div>

      <!-- Content -->
      <div class="lg:col-span-8">
        <div class="flex flex-col sm:flex-row gap-8 items-start">

          <!-- Photo -->
          {siteConfig.photo && (
            <div class="flex-shrink-0">
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/${siteConfig.photo.replace(/^\//, "")}`}
                alt={`${siteConfig.name} profile photo`}
                width="160"
                height="160"
                class="w-32 h-32 sm:w-40 sm:h-40 rounded-2xl object-cover object-top shadow-md"
                loading="eager"
              />
            </div>
          )}

          <!-- Text -->
          <div class="space-y-5">
            <p class="text-base sm:text-lg leading-relaxed text-gray-600">
              {siteConfig.aboutMe}
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
