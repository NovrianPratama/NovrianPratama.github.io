---
import { siteConfig } from "../config";
---

<section id="about" class="px-5 py-12 sm:px-8 sm:py-16 md:px-12 md:py-20 bg-white dark:bg-zinc-900 transition-colors duration-200">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">

      <!-- Section label -->
      <div class="lg:col-span-4">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 dark:text-zinc-100">
          About Me
        </h2>
        <div class="w-14 h-1.5 mt-2.5 rounded-full bg-[#0F766E] dark:bg-teal-400"></div>
      </div>

      <!-- Content -->
      <div class="lg:col-span-8">
        <div class="flex flex-col sm:flex-row gap-6 sm:gap-8 items-start">

          <!-- Photo -->
          {siteConfig.photo && (
            <div class="flex-shrink-0">
              <img
                src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/${siteConfig.photo.replace(/^\//, "")}`}
                alt={`${siteConfig.name} profile photo`}
                width="160"
                height="160"
                class="w-28 h-28 sm:w-36 sm:h-36 rounded-2xl object-cover object-top shadow-md ring-1 ring-gray-200 dark:ring-white/10"
                loading="eager"
              />
            </div>
          )}

          <!-- Text -->
          <div class="space-y-4">
            <p class="text-base sm:text-lg leading-relaxed text-gray-600 dark:text-zinc-400">
              {siteConfig.aboutMe}
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
